# ============================================
# TERMINAL ENHANCEMENTS
# ============================================
# Last Updated: 2025-11-23
# Description: Modern CLI tools for improved
#              productivity and developer UX
# ============================================
#
# TABLE OF CONTENTS:
# ──────────────────────────────────────────
#  1. FZF (fuzzy finder) + fzf-tab (fuzzy tab completion)
#  2. Zoxide (smart cd)
#  3. Bat (better cat with syntax highlighting)
#  4. Eza (better ls with icons/git)
#  5. Ripgrep (better grep)
#  6. Fd (better find)
#  7. TLDR (simple man pages — provided by tlrc)
#  8. Zellij (modern terminal multiplexer)
#  9. Neovim (modal text editor)
# 10. Helpful Aliases (vif, cdf, lg, lzd, etc.)
# 11. zsh enhancements (autosuggestions + syntax highlighting)
# 12. AI/LLM shell tooling (llm, ollama, gh-copilot)
#
# ============================================

# ============================================
# 1. FZF (FUZZY FINDER)
# ============================================
# Enhanced command-line fuzzy finder
if command -v fzf > /dev/null; then
    # Set up fzf key bindings and fuzzy completion
    eval "$(fzf --zsh)"

    # Use fd instead of find for fzf (faster and respects .gitignore)
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

    # Source theme colors (generated by apply-theme.sh)
    [[ -f "$HOME/.zshrc-theme-env" ]] && source "$HOME/.zshrc-theme-env"

    # Customize fzf appearance (theme colors appended if available)
    export FZF_DEFAULT_OPTS="
        --height 40%
        --layout=reverse
        --border
        --inline-info
        ${FZF_THEME_COLORS:-}
    "

    # fzf-tab — replace zsh's default tab-complete menu with fzf
    # Must be sourced AFTER compinit and BEFORE zsh-syntax-highlighting (see section 11).
    if [[ -f /opt/homebrew/opt/fzf-tab/share/fzf-tab/fzf-tab.zsh ]]; then
        source /opt/homebrew/opt/fzf-tab/share/fzf-tab/fzf-tab.zsh
    fi
fi

# ============================================
# 2. ZOXIDE (SMART CD)
# ============================================
if command -v zoxide > /dev/null; then
    eval "$(zoxide init zsh)"
    # Wrap cd with zoxide so 'cd projects' uses frecency-based jumping
    # (Omarchy-inspired: muscle memory works, but smarter)
    alias cdi='zi'         # Interactive directory picker with fzf
    alias cdd='builtin cd' # Original cd if needed
    # Examples:
    #   cd projects    # Jump to most frecent directory matching 'projects'
    #   cdi projects   # Interactive selection with fzf
    #   cd ~/exact/path # Still works for exact paths
fi

# ============================================
# 3. BAT (BETTER CAT)
# ============================================
if command -v bat > /dev/null; then
    alias cat='bat --style=auto'
    alias catt='/bin/cat'  # Original cat if needed
    # Theme is set via ~/.config/bat/config (managed by apply-theme.sh)
fi

# ============================================
# 4. EZA (BETTER LS)
# ============================================
if command -v eza > /dev/null; then
    alias ls='eza --icons --group-directories-first'
    alias ll='eza --icons --long --group-directories-first --git'
    alias la='eza --icons --long --all --group-directories-first --git'
    alias tree='eza --icons --tree'
    alias lss='/bin/ls'  # Original ls if needed
fi

# ============================================
# 5. RIPGREP (BETTER GREP)
# ============================================
if command -v rg > /dev/null; then
    alias grep='rg'
    alias grepp='/usr/bin/grep'  # Original grep if needed
fi

# ============================================
# 6. FD (BETTER FIND)
# ============================================
if command -v fd > /dev/null; then
    alias find='fd'
    alias findd='/usr/bin/find'  # Original find if needed
fi

# ============================================
# 7. TLDR (SIMPLE MAN PAGES)
# ============================================
if command -v tldr > /dev/null; then
    alias help='tldr'
fi

# ============================================
# 8. ZELLIJ (MODERN TERMINAL MULTIPLEXER)
# ============================================
# Modern Rust-based alternative to tmux with on-screen hints

if command -v zellij > /dev/null; then
    # Session management
    alias za='zellij attach'                    # Attach to session
    alias zk='zellij kill-session'              # Kill session
    alias zl='zellij list-sessions'             # List sessions
    alias zn='zellij -s'                        # New named session

    # Layout shortcuts
    alias zr='zellij --layout rails'            # Rails layout
    alias zp='zellij --layout phoenix'          # Phoenix layout
    alias zw='zellij --layout work'             # Work layout

    # Quick actions
    alias zt='zellij action new-tab'            # New tab
    alias zc='zellij action close-tab'          # Close tab
fi

# ============================================
# 9. NEOVIM
# ============================================
# Modern modal text editor with LSP support

if command -v nvim > /dev/null; then
    # Replace vim with neovim
    alias vim='nvim'
    alias vi='nvim'
    alias v='nvim'

    # Quick edits
    alias vimrc='nvim ~/.config/nvim/init.lua'
    alias vz='nvim ~/.zshrc'
    alias vt='nvim ~/.tmux.conf'
    alias vze='nvim ~/.zshrc-terminal-enhancements'

    # Project root editing
    alias vv='nvim .'
fi

# ============================================
# 10. HELPFUL ALIASES
# ============================================

# Quick directory navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# Git with fzf integration
unalias glog 2>/dev/null
glog() {
  git log --graph --color=always \
      --format="%C(auto)%h%d %s %C(black)%C(bold)%cr" "$@" |
  fzf --ansi --no-sort --reverse --tiebreak=index \
      --preview 'f() { set -- $(echo -- "$@" | /usr/bin/grep -o "[a-f0-9]\{7\}"); [ $# -eq 0 ] || git show --color=always $1; }; f {}' \
      --preview-window=right:60% \
      --bind "ctrl-y:execute-silent(echo {} | /usr/bin/grep -o '[a-f0-9]\{7\}' | head -1 | pbcopy)+abort"
}

# Find and edit files quickly
alias vif='$EDITOR $(fzf)'  # Open file with your default EDITOR using fzf
alias cdf='cd $(fd --type d | fzf)'  # cd into directory using fzf

# Process management
alias psg='ps aux | rg'  # Find processes with ripgrep

# Disk usage
alias du='du -h'
alias df='df -h'

# Lazygit & Lazydocker
alias lg='lazygit'
alias lzg='lazygit'
alias lzd='lazydocker'

# ============================================
# 11. ZSH ENHANCEMENTS
# ============================================
# zsh-autosuggestions: fish-style ghost-text completion from history.
#   Press → (right arrow) or End to accept the suggestion.
# zsh-syntax-highlighting: colors commands as you type so typos and unknown
#   commands stand out in red before you hit enter.
# Order matters: autosuggestions first, syntax-highlighting LAST.

if [[ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
    source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
    ZSH_AUTOSUGGEST_STRATEGY=(history completion)
fi

if [[ -f /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
    source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# ============================================
# 12. AI / LLM SHELL TOOLING
# ============================================
# `llm` (Simon Willison): pipe text through an LLM. Replaces mods (charm sunset
#         that tool 2026-03-09 with an unfixed ollama streaming bug).
#         First run: set a default model with `llm models default qwen2.5-coder:7b`.
#         Examples:
#           cat error.log | llm "what does this error mean?"
#           git diff | llm -s "summarize for a commit message"
#           llm "explain SIGPIPE in 3 sentences"
#           cat script.sh | llm -t reviewer       # use a saved template
#           llm -m gpt-4o "complex question"      # switch model per call
#         Plugins extend it: `llm install llm-anthropic llm-gemini llm-ollama`.
#         Templates (system prompts) live in ~/Library/Application Support/io.datasette.llm/templates/
#
# `ollama`: local LLM runtime backing `llm` for offline / private workflows.
#         Pull a model once, llm picks it up automatically.
#         Example:
#           ollama pull qwen2.5-coder:7b
#           llm install llm-ollama
#           cat script.sh | llm -m qwen2.5-coder:7b "review this"
#
# `gh copilot`: GitHub Copilot CLI (built-in to gh ≥ 2.49; requires Copilot subscription).
#         Examples:
#           gh copilot suggest "find files larger than 100MB"
#           gh copilot explain "git log --since=7.days"
#         Aliases below shorten the common cases.

if command -v gh > /dev/null && gh copilot --help >/dev/null 2>&1; then
    alias ghcs='gh copilot suggest'
    alias ghce='gh copilot explain'
fi

# Quick "explain the last command" via llm if available
if command -v llm > /dev/null; then
    explain-last() {
        local last_cmd
        last_cmd=$(fc -ln -1)
        echo "Explaining: $last_cmd"
        echo "$last_cmd" | llm "Explain this shell command in plain English"
    }
fi

