# 7. TLDR (SIMPLE MAN PAGES)
# ============================================
if command -v tldr > /dev/null; then
    alias help='tldr'
fi

# ============================================
# 8. ZELLIJ (TERMINAL MULTIPLEXER)
# ============================================
# Rust-based multiplexer with on-screen hints

if command -v zellij > /dev/null; then
