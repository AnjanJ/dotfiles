# ============================================
# 1. FZF (FUZZY FINDER)
# ============================================
# Enhanced command-line fuzzy finder
if command -v fzf > /dev/null; then
    # Set up fzf key bindings and fuzzy completion
    eval "$(fzf --zsh)"

    # Use fd instead of find for fzf (faster and respects .gitignore)
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

    # Source theme colors (generated by apply-theme.sh)
    [[ -f "$HOME/.zshrc-theme-env" ]] && source "$HOME/.zshrc-theme-env"

    # Customize fzf appearance (theme colors appended if available)
    export FZF_DEFAULT_OPTS="
        --height 40%
        --layout=reverse
        --border
        --inline-info
        ${FZF_THEME_COLORS:-}
    "

    # fzf-tab — replace zsh's default tab-complete menu with fzf
    # Must be sourced AFTER compinit and BEFORE zsh-syntax-highlighting (see section 11).
    if [[ -f /opt/homebrew/opt/fzf-tab/share/fzf-tab/fzf-tab.zsh ]]; then
        source /opt/homebrew/opt/fzf-tab/share/fzf-tab/fzf-tab.zsh
    fi
fi

# ============================================
# 2. ZOXIDE (SMART CD)
# ============================================
if command -v zoxide > /dev/null; then
    eval "$(zoxide init zsh)"
    # Wrap cd with zoxide so 'cd projects' uses frecency-based jumping
    # (Omarchy-inspired: muscle memory works, but smarter)
    alias cdi='zi'         # Interactive directory picker with fzf
    alias cdd='builtin cd' # Original cd if needed
    # Examples:
    #   cd projects    # Jump to most frecent directory matching 'projects'
    #   cdi projects   # Interactive selection with fzf
    #   cd ~/exact/path # Still works for exact paths
fi

# ============================================
# 3. BAT (BETTER CAT)
# ============================================
if command -v bat > /dev/null; then
    alias cat='bat --style=auto'
    alias catt='/bin/cat'  # Original cat if needed
    # Theme is set via ~/.config/bat/config (managed by apply-theme.sh)
fi

# ============================================
# 4. EZA (BETTER LS)
# ============================================
if command -v eza > /dev/null; then
    alias ls='eza --icons --group-directories-first'
    alias ll='eza --icons --long --group-directories-first --git'
    alias la='eza --icons --long --all --group-directories-first --git'
    alias tree='eza --icons --tree'
    alias lss='/bin/ls'  # Original ls if needed
fi

# ============================================
# 5. RIPGREP (BETTER GREP)
# ============================================
if command -v rg > /dev/null; then
    alias grep='rg'
    alias grepp='/usr/bin/grep'  # Original grep if needed
fi

# ============================================
# 6. FD (BETTER FIND)
# ============================================
