# ============================================
# 10. HELPFUL ALIASES
# ============================================

# Quick directory navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# Git with fzf integration
unalias glog 2>/dev/null
glog() {
  git log --graph --color=always \
      --format="%C(auto)%h%d %s %C(black)%C(bold)%cr" "$@" |
  fzf --ansi --no-sort --reverse --tiebreak=index \
      --preview 'f() { set -- $(echo -- "$@" | /usr/bin/grep -o "[a-f0-9]\{7\}"); [ $# -eq 0 ] || git show --color=always $1; }; f {}' \
      --preview-window=right:60% \
      --bind "ctrl-y:execute-silent(echo {} | /usr/bin/grep -o '[a-f0-9]\{7\}' | head -1 | pbcopy)+abort"
}

# Find and edit files quickly
alias vif='$EDITOR $(fzf)'  # Open file with your default EDITOR using fzf
alias cdf='cd $(fd --type d | fzf)'  # cd into directory using fzf

# Process management
alias psg='ps aux | rg'  # Find processes with ripgrep

# Disk usage
alias du='du -h'
alias df='df -h'

# Lazygit & Lazydocker
# lazygit merges every file in LG_CONFIG_FILE; the second one is the
# rendered theme block, so config.yml itself never carries colours.
if [[ -f "${DOTFILES_THEME_DIR:-$HOME/.local/state/dotfiles/current/theme}/lazygit.yml" ]]; then
    export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml,${DOTFILES_THEME_DIR:-$HOME/.local/state/dotfiles/current/theme}/lazygit.yml"
fi
alias lg='lazygit'
alias lzg='lazygit'
alias lzd='lazydocker'

# ============================================
# 11. ZSH ENHANCEMENTS
# ============================================
# zsh-autosuggestions: fish-style ghost-text completion from history.
#   Press → (right arrow) or End to accept the suggestion.
# zsh-syntax-highlighting: colors commands as you type so typos and unknown
#   commands stand out in red before you hit enter.
# Order matters: autosuggestions first, syntax-highlighting LAST now lives in .zshrc.

if [[ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
    source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
    ZSH_AUTOSUGGEST_STRATEGY=(history completion)
fi

if command -v atuin > /dev/null; then
    eval "$(atuin init zsh)"
fi

# ============================================
# 12. AI / LLM SHELL TOOLING
# ============================================
# `llm` (Simon Willison): pipe text through an LLM. Replaces mods (charm sunset
#         that tool 2026-03-09 with an unfixed ollama streaming bug).
#         First run: set a default model with `llm models default qwen2.5-coder:7b`.
#         Examples:
#           cat error.log | llm "what does this error mean?"
#           git diff | llm -s "summarize for a commit message"
#           llm "explain SIGPIPE in 3 sentences"
#           cat script.sh | llm -t reviewer       # use a saved template
#           llm -m gpt-4o "complex question"      # switch model per call
#         Plugins extend it: `llm install llm-anthropic llm-gemini llm-ollama`.
#         Templates (system prompts) live in ~/Library/Application Support/io.datasette.llm/templates/
#
# `ollama`: local LLM runtime backing `llm` for offline / private workflows.
#         Pull a model once, llm picks it up automatically.
#         Example:
#           ollama pull qwen2.5-coder:7b
#           llm install llm-ollama
#           cat script.sh | llm -m qwen2.5-coder:7b "review this"
#
# `gh copilot`: GitHub Copilot CLI (built-in to gh ≥ 2.49; requires Copilot subscription).
#         Examples:
#           gh copilot suggest "find files larger than 100MB"
#           gh copilot explain "git log --since=7.days"
#         Aliases below shorten the common cases.

# Defined unconditionally: probing with `gh copilot --help` at startup cost
# ~115ms on every shell (it loads the full gh binary and its extensions).
# If the extension is absent the alias simply errors when used, which is a
# far better trade than paying the probe on every single prompt.
if command -v gh > /dev/null; then
    alias ghcs='gh copilot suggest'
    alias ghce='gh copilot explain'
fi

# Quick "explain the last command" via llm if available
if command -v llm > /dev/null; then
    explain-last() {
        local last_cmd
        last_cmd=$(fc -ln -1)
        echo "Explaining: $last_cmd"
        echo "$last_cmd" | llm "Explain this shell command in plain English"
    }
fi

# ============================================
# 13. WORKTREES, ARCHIVES, SSH PORT FORWARDS
# ============================================
# Ported from Omarchy's shell functions (default/bash/fns). `ga`/`gd`
# stay git add/diff here, so the worktree pair is gwa/gwr.

# gwa <branch>: new worktree and branch beside this repo, trusted by
# mise (the .mise.toml is the same file, but trust is per path), then
# cd into it. Sibling directory: <repo>--<branch>.
gwa() {
  if [[ -z "$1" ]]; then
    echo "Usage: gwa <branch>" >&2
    return 1
  fi
  local root branch="$1" wt_path
  root="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "Not in a git repository" >&2; return 1; }
  wt_path="$(dirname "$root")/$(basename "$root")--${branch//\//-}"
  git worktree add -b "$branch" "$wt_path" || return 1
  command -v mise >/dev/null 2>&1 && mise trust "$wt_path" >/dev/null 2>&1
  cd "$wt_path" || return 1
}

# gwr: remove the worktree you are standing in (made by gwa) and its
# branch, after a confirmation. Refuses anything not named <repo>--<branch>.
gwr() {
  local cwd worktree root branch
  cwd="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "Not in a git repository" >&2; return 1; }
  worktree="$(basename "$cwd")"
  root="${worktree%%--*}"
  branch="${worktree#*--}"
  if [[ "$root" == "$worktree" ]]; then
    echo "$worktree is not a gwa worktree (<repo>--<branch>)" >&2
    return 1
  fi
  if [[ -z "${GWR_YES:-}" ]]; then
    read -q "REPLY?Remove worktree $worktree and branch $branch? [y/N] " || { echo; return 1; }
    echo
  fi
  cd "$(dirname "$cwd")/$root" || return 1
  git worktree remove "$cwd" --force || return 1
  git branch -D "$branch"
}

# compress <file-or-dir> -> <name>.tar.gz next to it; decompress <archive>
compress() {
  [[ -n "$1" ]] || { echo "Usage: compress <file-or-dir>" >&2; return 1; }
  tar -czf "${1%/}.tar.gz" "${1%/}" && echo "${1%/}.tar.gz"
}
decompress() {
  [[ -n "$1" ]] || { echo "Usage: decompress <archive.tar.gz>" >&2; return 1; }
  tar -xzf "$1"
}

# SSH port forwards, so a dev server on a remote box answers on
# localhost (secure-context privileges included):
#   fip nyc-dev 3000 5432    forward ports; dip 3000 stop one; lip list them
fip() {
  (( $# >= 2 )) || { echo "Usage: fip <host> <port> [port...]" >&2; return 1; }
  local host="$1" port
  shift
  for port in "$@"; do
    ssh -f -N -L "${port}:localhost:${port}" "$host" && echo "Forwarding localhost:$port -> $host:$port"
  done
}
dip() {
  (( $# >= 1 )) || { echo "Usage: dip <port> [port...]" >&2; return 1; }
  local port
  for port in "$@"; do
    if pkill -f "ssh.*-L ${port}:localhost:${port}"; then
      echo "Stopped forwarding port $port"
    else
      echo "No forwarding on port $port"
    fi
  done
}
lip() {
  pgrep -fl "ssh.*-L [0-9]+:localhost:[0-9]+" || echo "No active forwards"
}

