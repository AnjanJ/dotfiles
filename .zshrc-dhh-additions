# Note: PG_VERSION is set in main ~/.zshrc

# Start common development services
devstart() {
  echo "🚀 Starting development services..."

  # Redis (if using Sidekiq)
  if command -v redis-server &> /dev/null; then
    redis-server --daemonize yes
    echo "✅ Redis started"
  fi

  # PostgreSQL (uses $PG_VERSION from main config)
  if command -v postgres &> /dev/null; then
    brew services start postgresql@${PG_VERSION}
    echo "✅ PostgreSQL started"
  fi

  # Mailcatcher (for email testing)
  if command -v mailcatcher &> /dev/null; then
    mailcatcher
    echo "✅ Mailcatcher started at http://localhost:1080"
  fi
}

# Stop development services
devstop() {
  echo "🛑 Stopping development services..."
  brew services stop postgresql@${PG_VERSION}
  redis-cli shutdown 2>/dev/null
  pkill -f mailcatcher
  echo "✅ Services stopped"
}

# Sidekiq queue status (quick check without opening web UI)
sq() {
  if ! command -v redis-cli &> /dev/null; then
    echo "redis-cli not found"
    return 1
  fi
  if ! redis-cli ping &> /dev/null 2>&1; then
    echo "Redis not running"
    return 1
  fi
  echo "=== Sidekiq Status ==="
  redis-cli LLEN queue:default 2>/dev/null | xargs echo "  Default queue:"
  redis-cli LLEN queue:mailers 2>/dev/null | xargs echo "  Mailers queue:"
  redis-cli ZCARD schedule 2>/dev/null | xargs echo "  Scheduled:"
  redis-cli ZCARD retry 2>/dev/null | xargs echo "  Retries:"
  redis-cli ZCARD dead 2>/dev/null | xargs echo "  Dead:"
}

