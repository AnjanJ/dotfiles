# Rails setup templates (.rubocop.yml, lefthook.yml, ci.yml, etc.).
# Not shipped with this repo — point RAILS_TEMPLATES_DIR at your own
# collection, or set it in ~/.zshrc.local.
RAILS_TEMPLATES_DIR="${RAILS_TEMPLATES_DIR:-${HOME}/code/Tutorials/Dev Workflow/workflow/rails-templates/templates}"

# Check if we're in a Rails project
_check_rails_project() {
  if [[ ! -f "Gemfile" ]]; then
    echo "❌ Not in a Rails project (no Gemfile found)"
    return 1
  fi
  return 0
}

# Templates live outside this repo — fail once with a useful message
# rather than five separate "Template not found" errors.
_check_rails_templates() {
  if [[ ! -d "$RAILS_TEMPLATES_DIR" ]]; then
    echo "❌ Rails templates not found at: $RAILS_TEMPLATES_DIR"
    echo "💡 Set RAILS_TEMPLATES_DIR in ~/.zshrc.local to your templates directory."
    echo "   Expected files: .rubocop.yml, lefthook.yml, ci.yml,"
    echo "                   spec_helper_simplecov.rb, Gemfile.additions"
    return 1
  fi
  return 0
}

# Setup Lefthook (Git hooks manager)
rails-setup-lefthook() {
  _check_rails_project || return 1
  _check_rails_templates || return 1

  echo "📋 Installing Lefthook..."

  # Copy template
  if [[ -f "${RAILS_TEMPLATES_DIR}/lefthook.yml" ]]; then
    cp "${RAILS_TEMPLATES_DIR}/lefthook.yml" ./lefthook.yml
    echo "✅ Copied lefthook.yml"
  else
    echo "❌ Template not found: ${RAILS_TEMPLATES_DIR}/lefthook.yml"
    return 1
  fi

  # Install lefthook
  if bundle exec lefthook install 2>/dev/null; then
    echo "✅ Lefthook installed successfully"
  else
    echo "⚠️  Run 'bundle install' first, then 'bundle exec lefthook install'"
  fi

  echo ""
  echo "📚 Lefthook configured with:"
  echo "   - Pre-commit: RuboCop (auto-fix), RSpec (fail-fast), Brakeman"
  echo "   - Pre-push: Full RSpec suite with coverage check"
  echo "   - Commit-msg: Conventional commit format enforcement"
}

# Setup RuboCop with Airbnb style guide
rails-setup-rubocop() {
  _check_rails_project || return 1
  _check_rails_templates || return 1

  echo "📋 Installing RuboCop configuration..."

  # Copy template
  if [[ -f "${RAILS_TEMPLATES_DIR}/.rubocop.yml" ]]; then
    cp "${RAILS_TEMPLATES_DIR}/.rubocop.yml" ./.rubocop.yml
    echo "✅ Copied .rubocop.yml (Airbnb style guide)"
  else
    echo "❌ Template not found: ${RAILS_TEMPLATES_DIR}/.rubocop.yml"
    return 1
  fi

  echo ""
  echo "📚 RuboCop configured with:"
  echo "   - Airbnb Ruby Style Guide"
  echo "   - Plugins: rails, rspec, performance, capybara, factory_bot"
  echo "   - 120 char line length"
  echo "   - Smart exclusions for spec/, config/, bin/"
}

# Setup SimpleCov (test coverage)
rails-setup-simplecov() {
  _check_rails_project || return 1
  _check_rails_templates || return 1

  echo "📋 Installing SimpleCov configuration..."

  # Check if spec_helper.rb exists
  if [[ ! -f "spec/spec_helper.rb" ]]; then
    echo "❌ spec/spec_helper.rb not found. Install RSpec first."
    return 1
  fi

  # Copy template content to top of spec_helper.rb
  if [[ -f "${RAILS_TEMPLATES_DIR}/spec_helper_simplecov.rb" ]]; then
    # Create backup
    cp spec/spec_helper.rb spec/spec_helper.rb.backup

    # Prepend SimpleCov config
    cat "${RAILS_TEMPLATES_DIR}/spec_helper_simplecov.rb" spec/spec_helper.rb.backup > spec/spec_helper.rb

    echo "✅ Added SimpleCov to spec/spec_helper.rb"
    echo "   (Backup saved as spec/spec_helper.rb.backup)"
  else
    echo "❌ Template not found: ${RAILS_TEMPLATES_DIR}/spec_helper_simplecov.rb"
    return 1
  fi

  echo ""
  echo "📚 SimpleCov configured with:"
  echo "   - 90% minimum coverage requirement"
  echo "   - Groups: Models, Controllers, Services"
  echo "   - Filters: spec/, config/, vendor/, channels/, jobs/, mailers/"
}

# Setup GitHub Actions CI
rails-setup-ci() {
  _check_rails_project || return 1
  _check_rails_templates || return 1

  echo "📋 Installing GitHub Actions CI..."

  # Create .github/workflows directory
  mkdir -p .github/workflows

  # Copy template
  if [[ -f "${RAILS_TEMPLATES_DIR}/ci.yml" ]]; then
    cp "${RAILS_TEMPLATES_DIR}/ci.yml" .github/workflows/ci.yml
    echo "✅ Copied .github/workflows/ci.yml"
  else
    echo "❌ Template not found: ${RAILS_TEMPLATES_DIR}/ci.yml"
    return 1
  fi

  echo ""
  echo "📚 GitHub Actions CI configured with:"
  echo "   - Security scan (Brakeman)"
  echo "   - Linting (RuboCop)"
  echo "   - Tests (RSpec with coverage upload)"
  echo "   - Runs on: pull_request, push to main"
}

