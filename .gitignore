# ============================================
# DOTFILES GITIGNORE
# ============================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Neovim
.config/nvim/lazy-lock.json
.config/nvim/.luarc.json
.config/nvim/plugin/
*.bak
*.swp
*.swo
*~

# Backup files
*.old
*.orig

# Local-only Brewfile backup (rotated by update.sh; git history is the real backup)
Brewfile.backup

# Machine-local Claude Code settings (paths, permissions specific to this machine)
.claude/settings.local.json

# Logs
*.log

# Sensitive data
.env
.env.local
*_history
.zsh_history

# Plugin directories (will be installed by package managers)
.tmux/plugins/*
!.tmux/plugins/tpm

# Generated by `dotfiles theme` (rendered from themes/<name>/colors.toml)
.config/ghostty/theme.generated
.config/zellij/themes/dotfiles.kdl
.config/sketchybar/colors.sh
.config/borders/colors.sh

# Cache directories
.cache/
.local/state/

# Private/local configurations
*.local
*.private
.zshrc-work  # Work-specific configuration (keep private)

# Editor-specific
.vscode/
.idea/
