// ============================================
// CATPPUCCIN MOCHA THEME FOR ZELLIJ
// ============================================
// Based on catppuccin/catppuccin
// Repository: https://github.com/catppuccin/catppuccin
// Color palette: Mocha (darkest) variant
// ============================================

themes {
    catppuccin {
        // Foreground and Background
        fg 205 214 244     // #cdd6f4 - Text
        bg 30 30 46        // #1e1e2e - Base

        // Normal colors
        black 69 71 90     // #45475a - Surface1
        red 243 139 168    // #f38ba8 - Red
        green 166 227 161  // #a6e3a1 - Green
        yellow 249 226 175 // #f9e2af - Yellow
        blue 137 180 250   // #89b4fa - Blue
        magenta 245 194 231 // #f5c2e7 - Pink
        cyan 148 226 213   // #94e2d5 - Teal
        white 186 194 222  // #bac2de - Subtext1

        // Bright colors
        bright-black 88 91 112    // #585b70 - Surface2
        bright-red 243 139 168    // #f38ba8
        bright-green 166 227 161  // #a6e3a1
        bright-yellow 249 226 175 // #f9e2af
        bright-blue 137 180 250   // #89b4fa
        bright-magenta 245 194 231 // #f5c2e7
        bright-cyan 148 226 213   // #94e2d5
        bright-white 166 173 200  // #a6adc8 - Subtext0

        // UI colors
        orange 250 179 135       // #fab387 - Peach
    }
}
