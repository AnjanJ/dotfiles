# Generated by `dotfiles theme` from themes/{{ theme_name }}/colors.toml — do not edit.
# eza reads this as $EZA_CONFIG_DIR/theme.yml (~/.config/eza, set in
# .zshrc-terminal-enhancements). Keys: man 5 eza_colors-explanation.
filekinds:
  normal: {foreground: "{{ foreground }}"}
  directory: {foreground: "{{ blue }}", is_bold: true}
  symlink: {foreground: "{{ cyan }}"}
  pipe: {foreground: "{{ yellow }}"}
  block_device: {foreground: "{{ yellow }}", is_bold: true}
  char_device: {foreground: "{{ yellow }}", is_bold: true}
  socket: {foreground: "{{ magenta }}", is_bold: true}
  special: {foreground: "{{ yellow }}"}
  executable: {foreground: "{{ green }}", is_bold: true}
  mount_point: {foreground: "{{ blue }}", is_bold: true, is_underline: true}
perms:
  user_read: {foreground: "{{ green }}"}
  user_write: {foreground: "{{ yellow }}"}
  user_execute_file: {foreground: "{{ red }}", is_bold: true}
  user_execute_other: {foreground: "{{ red }}"}
  group_read: {foreground: "{{ green }}"}
  group_write: {foreground: "{{ yellow }}"}
  group_execute: {foreground: "{{ red }}"}
  other_read: {foreground: "{{ green }}"}
  other_write: {foreground: "{{ yellow }}"}
  other_execute: {foreground: "{{ red }}"}
  special_user_file: {foreground: "{{ magenta }}"}
  special_other: {foreground: "{{ magenta }}"}
  attribute: {foreground: "{{ muted }}"}
size:
  major: {foreground: "{{ muted }}"}
  minor: {foreground: "{{ muted }}"}
  number_byte: {foreground: "{{ green }}"}
  number_kilo: {foreground: "{{ green }}"}
  number_mega: {foreground: "{{ yellow }}"}
  number_giga: {foreground: "{{ orange }}"}
  number_huge: {foreground: "{{ red }}"}
  unit_byte: {foreground: "{{ green }}"}
  unit_kilo: {foreground: "{{ green }}"}
  unit_mega: {foreground: "{{ yellow }}"}
  unit_giga: {foreground: "{{ orange }}"}
  unit_huge: {foreground: "{{ red }}"}
users:
  user_you: {foreground: "{{ accent }}"}
  user_root: {foreground: "{{ red }}"}
  user_other: {foreground: "{{ muted }}"}
  group_yours: {foreground: "{{ muted }}"}
  group_other: {foreground: "{{ muted }}"}
  group_root: {foreground: "{{ red }}"}
links:
  normal: {foreground: "{{ green }}"}
  multi_link_file: {foreground: "{{ yellow }}"}
git:
  new: {foreground: "{{ green }}"}
  modified: {foreground: "{{ yellow }}"}
  deleted: {foreground: "{{ red }}"}
  renamed: {foreground: "{{ cyan }}"}
  ignored: {foreground: "{{ muted }}"}
  conflicted: {foreground: "{{ red }}", is_bold: true}
git_repo:
  branch_main: {foreground: "{{ green }}"}
  branch_other: {foreground: "{{ yellow }}"}
  git_clean: {foreground: "{{ green }}"}
  git_dirty: {foreground: "{{ yellow }}"}
punctuation: {foreground: "{{ muted }}"}
date: {foreground: "{{ blue }}"}
inode: {foreground: "{{ purple }}"}
blocks: {foreground: "{{ muted }}"}
header: {foreground: "{{ foreground }}", is_underline: true}
octal: {foreground: "{{ purple }}"}
flags: {foreground: "{{ muted }}"}
control_char: {foreground: "{{ red }}"}
broken_symlink: {foreground: "{{ red }}"}
broken_path_overlay: {is_underline: true}
