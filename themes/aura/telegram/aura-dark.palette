grayTransparent: #2d2b38cc
grayUI: #1c1b22
darkGrayText: #6d6d6d
accentSelect: #b599ff
selectText: #4d466e
border: #2d2b38
grayBackground: #1c1b22
grayForeground: #2d2b38
grayIcon: #adacae
accentIcon: #a277ff
badgeMuted: #6d6d6d
