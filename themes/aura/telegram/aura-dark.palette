//
// Aura Dark for Telegram for macOS (ru.keepcoder.Telegram).
//
// NOTE: this is the macOS client's .palette format, which is NOT the same
// as the .tdesktop-theme file next to it. That one is for Telegram Desktop
// (org.telegram.desktop) and this client cannot read it.
//
// Colours match themes/aura/theme.conf:
//   bg #15141b   fg #edecee   accent #a277ff
//   green #61ffca  red #ff6767  blue #82e2ff  yellow #ffca85
//
name: Aura Dark
parent: nightAccent
copyright: Aura theme by Dalton Menezes
isDark: 1

basicAccent: #a277ff
background: #15141b
text: #edecee
grayText: #adacae
link: #a277ff
