# ── Dotfiles CLI ──────────────────────────────

_dotfiles() {
    # Commands and their summaries come from the scripts' own metadata
    # headers via `dotfiles commands --plain` (route<TAB>summary<TAB>args),
    # so a new bin/dotfiles-* script completes without touching this file.
    local -a subcommands
    local line route summary
    while IFS=$'\t' read -r route summary _; do
        subcommands+=("${route// /-}:${summary}")
    done < <(dotfiles commands --plain 2>/dev/null)
    subcommands+=('commands:List commands (--json, --plain, --check)' 'edit:Open dotfiles in your editor' 'dir:Print dotfiles directory path')

    if (( CURRENT == 2 )); then
        _describe 'command' subcommands
        return
    fi

    case "${words[2]}" in
        theme)
            local -a themes=($(_dotfiles_theme_names))
            _describe 'theme' themes
            ;;
        hook)
            local -a events=(theme-set post-sync post-update)
            _describe 'event' events
            ;;
        toggle)
            local -a flags=(startup-apps borders auto-commit)
            _describe 'flag' flags
            ;;
        install)
            _arguments \
                '--interactive[Prompt for every choice]' \
                '--force[Force reinstall]' \
                '--name[Git user.name]:name' \
                '--email[Git personal email]:email' \
                '--work-email[Git work email]:email' \
                '--work-dir[Work directory]:directory:_directories' \
                '--theme[Theme]:theme:($(_dotfiles_theme_names))' \
                '--ssh[SSH mode]:mode:(1password existing generate skip)' \
                '--groups[Package groups to install]:groups' \
                '--no-macos-defaults[Skip macOS defaults]' \
                '--help[Show help]'
            ;;
        *)
            # Generic: offer every --flag named in the command's args metadata
            local -a flags
            local args
            args=$(dotfiles commands --plain 2>/dev/null | awk -F'\t' -v r="${words[2]// /-}" '{ gsub(/ /, "-", $1); if ($1 == r) print $3 }')
            for flag in ${(s: :)args}; do
                [[ "$flag" == --* ]] && flags+=("${flag//[\[\]]/}")
            done
            flags+=('--help')
            _describe 'option' flags
            ;;
    esac
}
compdef _dotfiles dotfiles

# Theme names come from themes/*/theme.conf, so a new theme completes
# without touching this file
_dotfiles_theme_names() {
    local dir="${DOTFILES_DIR:-$HOME/code/dotfiles}"
    [[ -d "$dir/themes" ]] || dir="$HOME/dotfiles"
    local conf
    for conf in "$dir"/themes/*/theme.conf(N); do
        echo "${conf:h:t}"
    done
}

_dotfiles_theme() {
    local -a themes=($(_dotfiles_theme_names))
    _describe 'theme' themes
}
compdef _dotfiles_theme dotfiles-theme

