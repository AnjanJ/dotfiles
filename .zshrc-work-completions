# ── Dotfiles CLI ──────────────────────────────

_dotfiles() {
    local -a subcommands
    subcommands=(
        'update:Update system & sync dotfiles repo'
        'sync:Quick refresh — pull, relink, reapply theme'
        'health:Run health check on all tools'
        'theme:Switch theme (tokyo-night|aura|catppuccin)'
        'install:Run full installer'
        'uninstall:Remove all symlinks'
        'backup:Snapshot dotfiles state'
        'doctor:Auto-fix common issues'
        'profile:Measure shell startup time'
        'export:Export setup snapshot'
        'add-theme:Scaffold a new theme directory'
        'cleanup:Remove Homebrew packages not in Brewfile'
        'migrate:Run pending one-off migrations'
        'hook:Run user hooks for an event'
        'edit:Open dotfiles in your editor'
        'dir:Print dotfiles directory path'
    )

    if (( CURRENT == 2 )); then
        _describe 'command' subcommands
    else
        case "${words[2]}" in
            theme)
                local -a themes=($(_dotfiles_theme_names))
                _describe 'theme' themes
                ;;
            migrate)
                _arguments \
                    '--pending[List pending migrations]' \
                    '--dry-run[Show what would run]' \
                    '--new[Create a migration]:slug'
                ;;
            hook)
                local -a events=(theme-set post-sync post-update)
                _describe 'event' events
                ;;
            backup)
                _arguments \
                    '--list[List available backups]' \
                    '--restore[Restore a backup]:backup name'
                ;;
            doctor)
                _arguments \
                    '--dry-run[Preview what would be fixed]'
                ;;
            profile)
                _arguments \
                    '--detailed[Show per-component timing]'
                ;;
            install)
                _arguments \
                    '--interactive[Prompt for every choice]' \
                    '--force[Force reinstall]' \
                    '--name[Git user.name]:name' \
                    '--email[Git personal email]:email' \
                    '--work-email[Git work email]:email' \
                    '--work-dir[Work directory]:directory:_directories' \
                    '--theme[Theme]:theme:($(_dotfiles_theme_names))' \
                    '--ssh[SSH mode]:mode:(1password existing generate skip)' \
                    '--groups[Package groups to install]:groups' \
                    '--no-macos-defaults[Skip macOS defaults]' \
                    '--help[Show help]'
                ;;
            update)
                _arguments \
                    '--interactive[Prompt before each step]' \
                    '--help[Show help]'
                ;;
            sync)
                _arguments \
                    '--dry-run[Show what would change]' \
                    '--help[Show help]'
                ;;
            export)
                _arguments \
                    '--json[Output as JSON]' \
                    '--help[Show help]'
                ;;
        esac
    fi
}
compdef _dotfiles dotfiles

# Theme names come from themes/*/theme.conf, so a new theme completes
# without touching this file
_dotfiles_theme_names() {
    local dir="${DOTFILES_DIR:-$HOME/code/dotfiles}"
    [[ -d "$dir/themes" ]] || dir="$HOME/dotfiles"
    local conf
    for conf in "$dir"/themes/*/theme.conf(N); do
        echo "${conf:h:t}"
    done
}

_dotfiles_theme() {
    local -a themes=($(_dotfiles_theme_names))
    _describe 'theme' themes
}
compdef _dotfiles_theme dotfiles-theme

_dotfiles_backup() {
    _arguments \
