#!/usr/bin/env bash
# dotfiles:summary=Install MemPalace, connect it to Claude Code, and run one shared hub so every session can write
# dotfiles:args=[--no-hub] [--remove-hub]
#
# MemPalace is personal and opt-in: install.sh runs this only with
# --mempalace (or "mempalace": true in the answers file, or
# DOTFILES_MEMPALACE=yes); nothing else installs it. Safe to re-run: each
# step only acts when something is missing or has changed.
#
#   1. Installs the mempalace uv tool when it is missing. Upgrades are
#      `dotfiles update`'s job and keep any version pin it was installed with.
#   2. Registers the mempalace MCP server with Claude Code (user scope) when
#      Claude Code has none.
#   3. Runs `mempalace serve` as a LaunchAgent (com.dotfiles.mempalace-hub on
#      127.0.0.1:8765, started at login, restarted if it exits).
#
# Why a hub: every Claude Code session starts its own mempalace-mcp, and the
# first one to write takes the palace's single-writer lock, so every other
# session is read-only ("Peer MCP writer active; this server is read-only
# for mutating tools") until that one exits. While a hub runs, each
# mempalace-mcp forwards its requests to it instead; the check runs per
# request, so open sessions switch over without a restart. If a session
# holds the lock when the hub starts, the hub waits, launchd retries, and it
# takes over once that session closes.
#
# The palace stays in ~/.mempalace (made 700 here), never in a repository:
# ~/.gitignore_global ignores it in every repo on the machine.
#
#   --no-hub      steps 1 and 2 only
#   --remove-hub  stop the hub and remove its LaunchAgent; nothing else changes
#
# Overrides for tests: DOTFILES_LAUNCH_AGENTS_DIR, DOTFILES_STATE_DIR,
# DOTFILES_CLAUDE_JSON, DOTFILES_MEMPALACE_HEALTH_URL, DOTFILES_MEMPALACE_WAIT.
# Bash 3.2 compatible: install.sh runs it.

set -euo pipefail

LABEL="com.dotfiles.mempalace-hub"
AGENTS_DIR="${DOTFILES_LAUNCH_AGENTS_DIR:-$HOME/Library/LaunchAgents}"
PLIST="$AGENTS_DIR/$LABEL.plist"
STATE_DIR="${DOTFILES_STATE_DIR:-$HOME/.local/state/dotfiles}"
LOG="$STATE_DIR/mempalace-hub.log"
CLAUDE_JSON="${DOTFILES_CLAUDE_JSON:-$HOME/.claude.json}"
HEALTH="${DOTFILES_MEMPALACE_HEALTH_URL:-http://127.0.0.1:8765/healthz}"
WAIT="${DOTFILES_MEMPALACE_WAIT:-90}"
DOMAIN="gui/$(id -u)"

HUB=true
REMOVE=false
for arg in "$@"; do
    case "$arg" in
        --no-hub) HUB=false ;;
        --remove-hub) REMOVE=true ;;
        -h|--help)
            sed -n '4,30p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            echo "Unknown option '$arg' (expected --no-hub or --remove-hub)" >&2
            exit 1
            ;;
    esac
done

say() { printf '  %s\n' "$*"; }
warn() { printf '  ⚠ %s\n' "$*" >&2; }

hub_up() { curl -fsS --max-time 2 "$HEALTH" >/dev/null 2>&1; }

stop_hub() {
    launchctl bootout "$DOMAIN/$LABEL" >/dev/null 2>&1 \
        || launchctl unload "$PLIST" >/dev/null 2>&1 \
        || true
}

if [[ "$REMOVE" == true ]]; then
    stop_hub
    rm -f "$PLIST"
    say "MemPalace hub stopped and its LaunchAgent removed."
    say "Claude Code sessions are back to one writer at a time."
    exit 0
fi

echo "MemPalace"

# ── 1. Install ────────────────────────────────
export PATH="$HOME/.local/bin:$PATH"
if ! command -v mempalace >/dev/null 2>&1; then
    if ! command -v uv >/dev/null 2>&1; then
        echo "  uv is needed to install MemPalace (brew install uv)" >&2
        exit 1
    fi
    uv tool install mempalace
fi
MEMPALACE=$(command -v mempalace)
say "installed: $("$MEMPALACE" --version 2>/dev/null | head -1) ($MEMPALACE)"
mkdir -p "$HOME/.mempalace"
chmod 700 "$HOME/.mempalace"

# ── 2. Connect to Claude Code ─────────────────
# Read the config rather than `claude mcp get`, which starts the server to
# report its status.
registered=false
if [[ -f "$CLAUDE_JSON" ]] && command -v jq >/dev/null 2>&1 \
    && jq -e '.mcpServers.mempalace' "$CLAUDE_JSON" >/dev/null 2>&1; then
    registered=true
fi
if [[ "$registered" == true ]]; then
    say "Claude Code: the mempalace server is registered"
elif command -v claude >/dev/null 2>&1; then
    claude mcp add --scope user mempalace -- mempalace-mcp >/dev/null
    say "Claude Code: registered the mempalace server (user scope)"
else
    say "Claude Code is not installed; once it is: claude mcp add --scope user mempalace -- mempalace-mcp"
fi

# ── 3. Shared hub ─────────────────────────────
if [[ "$HUB" == false ]]; then
    say "hub: skipped (--no-hub)"
    exit 0
fi

xml() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }
mkdir -p "$AGENTS_DIR" "$STATE_DIR"
chmod 700 "$STATE_DIR"
new_plist=$(cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$LABEL</string>
    <key>ProgramArguments</key>
    <array>
        <string>$(xml "$MEMPALACE")</string>
        <string>serve</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>$(xml "$HOME/.local/bin"):/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>$(xml "$LOG")</string>
    <key>StandardErrorPath</key>
    <string>$(xml "$LOG")</string>
</dict>
</plist>
EOF
)

changed=true
if [[ -f "$PLIST" ]] && [[ "$(cat "$PLIST")" == "$new_plist" ]]; then
    changed=false
fi
if [[ "$changed" == false ]] && hub_up; then
    say "hub: running on 127.0.0.1:8765, shared by every Claude Code session"
    exit 0
fi

printf '%s\n' "$new_plist" > "$PLIST"
stop_hub
if ! launchctl bootstrap "$DOMAIN" "$PLIST" >/dev/null 2>&1 \
    && ! launchctl load "$PLIST" >/dev/null 2>&1; then
    warn "could not load $PLIST; try: launchctl bootstrap $DOMAIN $PLIST"
    exit 1
fi

i=0
while [[ "$i" -lt "$WAIT" ]]; do
    if hub_up; then
        say "hub: running on 127.0.0.1:8765, shared by every Claude Code session"
        say "Open sessions switch to it on their next MemPalace call; nothing to restart."
        exit 0
    fi
    sleep 1
    i=$((i + 1))
done
warn "the hub did not answer within ${WAIT}s (log: $LOG)."
warn "A session that already holds the palace lock delays it; launchd keeps retrying and it takes over when that session closes."
exit 0
