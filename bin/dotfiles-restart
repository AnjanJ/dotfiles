#!/usr/bin/env bash
# dotfiles:summary=Restart a component now, or mark it for the end of the next update
# dotfiles:args=<aerospace|sketchybar|borders> | --later <component> | --pending | --list
#
# Restart markers are how a change that lands mid-update (a pulled
# aerospace.toml, a refreshed symlink, a migration) asks for a restart
# without doing it in the middle of the run. The marker is a file:
#
#   ~/.local/state/dotfiles/restart-<component>-required
#
#   dotfiles restart sketchybar          restart now
#   dotfiles restart --later aerospace   drop a marker; update/sync consume it
#   dotfiles restart --pending           restart every marked component, clear markers
#   dotfiles restart --list              print marked components; exit 0 if any, 1 if none
#
# A component that is not running is simply not restarted (its next launch
# reads the new config anyway) and the marker is still cleared.

set -euo pipefail

STATE_DIR="${DOTFILES_STATE_DIR:-$HOME/.local/state/dotfiles}"
COMPONENTS="aerospace sketchybar borders"

_usage() {
    echo "Usage: dotfiles restart <aerospace|sketchybar|borders>"
    echo "       dotfiles restart --later <component>"
    echo "       dotfiles restart --pending | --list"
}

_valid() {
    local c
    for c in $COMPONENTS; do [[ "$c" == "$1" ]] && return 0; done
    echo "Unknown component '$1' (expected one of: $COMPONENTS)" >&2
    return 1
}

_marker() { echo "$STATE_DIR/restart-$1-required"; }

_restart_now() {
    case "$1" in
        aerospace)
            # The process is AeroSpace; a case-sensitive `pgrep -x Aerospace`
            # never matched, which is how the old unconditional reload in
            # update.sh silently did nothing for months.
            if pgrep -xi aerospace >/dev/null 2>&1; then
                aerospace reload-config && echo "  aerospace: config reloaded"
            else
                echo "  aerospace: not running, nothing to reload"
            fi
            ;;
        sketchybar)
            if pgrep -x sketchybar >/dev/null 2>&1; then
                sketchybar --reload && echo "  sketchybar: reloaded"
            else
                echo "  sketchybar: not running, nothing to reload"
            fi
            ;;
        borders)
            # Launched by AeroSpace's after-startup command, so a restart is
            # kill-and-relaunch; honour the toggle the same way that does.
            if pgrep -x borders >/dev/null 2>&1; then
                pkill -x borders || true
                if bash "$(dirname "$0")/dotfiles-toggle" --enabled borders; then
                    (borders >/dev/null 2>&1 &)
                    echo "  borders: restarted"
                else
                    echo "  borders: stopped (toggled off)"
                fi
            else
                echo "  borders: not running, nothing to restart"
            fi
            ;;
    esac
}

case "${1:-}" in
    --help|-h|"")
        _usage
        [[ "${1:-}" == "" ]] && exit 1
        exit 0
        ;;
    --later)
        [[ -n "${2:-}" ]] || { _usage >&2; exit 1; }
        _valid "$2" || exit 1
        mkdir -p "$STATE_DIR"
        touch "$(_marker "$2")"
        ;;
    --list)
        found=false
        for c in $COMPONENTS; do
            if [[ -f "$(_marker "$c")" ]]; then
                echo "$c"
                found=true
            fi
        done
        [[ "$found" == true ]]
        ;;
    --pending)
        any=false
        for c in $COMPONENTS; do
            m="$(_marker "$c")"
            [[ -f "$m" ]] || continue
            any=true
            rm -f "$m"
            _restart_now "$c" || echo "  $c: restart failed" >&2
        done
        [[ "$any" == true ]] || echo "  Nothing marked for restart"
        ;;
    -*)
        _usage >&2
        exit 1
        ;;
    *)
        _valid "$1" || exit 1
        rm -f "$(_marker "$1")"
        _restart_now "$1"
        ;;
esac
