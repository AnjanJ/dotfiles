#!/usr/bin/env bash
# Scaffold a new theme directory
# Usage: dotfiles add-theme <name>
#
# A theme is one palette file (colors.toml) plus a small registry of the
# settings templates cannot derive from colours (theme.conf) and a Neovim
# plugin spec. Every other app config is rendered from the palette by
# `dotfiles theme <name>` via themes/_templates/*.tpl. Drop a hand-written
# file into overrides/ to replace a template's output for this theme only.

set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
source "$DOTFILES_DIR/scripts/_helpers.sh"

if [[ -z "${1:-}" || "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "Usage: dotfiles add-theme <name>"
    echo ""
    echo "Scaffold themes/<name>/ with colors.toml, theme.conf and a Neovim plugin stub."
    echo "Theme name must be lowercase letters, numbers, and hyphens only."
    echo ""
    echo "Example: dotfiles add-theme dracula"
    exit 0
fi

THEME_NAME="$1"

if [[ ! "$THEME_NAME" =~ ^[a-z0-9][a-z0-9-]*[a-z0-9]$ ]] && [[ ! "$THEME_NAME" =~ ^[a-z0-9]$ ]]; then
    echo "Error: Theme name must be lowercase letters, numbers, and hyphens only."
    echo "  Got: '$THEME_NAME'"
    exit 1
fi

THEME_DIR="$DOTFILES_DIR/themes/$THEME_NAME"

if [[ -d "$THEME_DIR" ]]; then
    echo "Error: Theme '$THEME_NAME' already exists at $THEME_DIR"
    exit 1
fi

echo ""
print_step "Scaffolding theme: $THEME_NAME"
echo ""

mkdir -p "$THEME_DIR"/{nvim,overrides}

# colors.toml — the palette. Same keys as Omarchy themes, so a palette
# from github.com/basecamp/omarchy/themes/<name>/colors.toml drops in as-is.
cat > "$THEME_DIR/colors.toml" << COLORS
# $THEME_NAME palette — every app config is rendered from this file.
# Keys match Omarchy's colors.toml, so palettes can be copied between the two.
# Only background/foreground/red..magenta are required; the renderer derives
# the rest (accent=blue, muted, selection, bright_*, dark/lighter_background)
# when a key is left out. Fill in what you know, delete what you don't.
mode = "dark"

accent = "#7aa2f7"
selection = "#292e42"
muted = "#565f89"

background = "#1a1b26"
dark_background = "#16161e"
darker_background = "#0e0e14"
lighter_background = "#24283b"

foreground = "#c0caf5"
dark_foreground = "#565f89"
light_foreground = "#a9b1d6"
bright_foreground = "#c0caf5"

black = "#15161e"
red = "#f7768e"
green = "#9ece6a"
yellow = "#e0af68"
blue = "#7aa2f7"
magenta = "#bb9af7"
cyan = "#7dcfff"
orange = "#ff9e64"
purple = "#bb9af7"

bright_black = "#414868"
bright_red = "#f7768e"
bright_green = "#9ece6a"
bright_yellow = "#e0af68"
bright_blue = "#7aa2f7"
bright_magenta = "#bb9af7"
bright_cyan = "#7dcfff"
COLORS

# theme.conf — settings templates cannot derive from a palette
cat > "$THEME_DIR/theme.conf" << CONF
# Theme registry for $THEME_NAME
# Colours live in colors.toml; this file holds the settings templates
# cannot derive from a palette (editor theme names, custom files).

# Neovim: plugin spec in nvim/<file>, and the colorscheme it provides
nvim_plugin_file="${THEME_NAME}-theme.lua"
nvim_colorscheme=""

# Editors (theme names as the apps know them)
vscode_theme=""
zed_theme=""

# bat / delta syntax theme (a bat theme name, or a .tmTheme shipped in bat/)
bat_theme=""
delta_theme=""

# Warp (built-in theme name, or a custom YAML shipped in warp/)
warp_theme=""
warp_custom_file=""
CONF

cat > "$THEME_DIR/nvim/${THEME_NAME}-theme.lua" << 'NVIM'
-- TODO: Replace with the actual theme plugin spec (loaded by
-- .config/nvim/lua/plugins/theme.lua when this theme is active)
return {
  "author/theme-plugin",
  lazy = false,
  priority = 1000,
}
NVIM

rendered_names=$(cd "$DOTFILES_DIR/themes/_templates" 2>/dev/null && for t in ./*.tpl; do [[ -f "$t" ]] && printf '%s ' "$(basename "$t" .tpl)"; done)
cat > "$THEME_DIR/overrides/README.md" << OVERRIDES
# overrides/

Any file here replaces the template output of the same name for **$THEME_NAME**
only, e.g. \`overrides/ghostty\` instead of \`themes/_templates/ghostty.tpl\`.

Rendered names: ${rendered_names:-(see themes/_templates/)}
OVERRIDES

cat > "$THEME_DIR/manual-instructions.txt" << MANUAL

╔═══════════════════════════════════════════════════════════╗
║   Manual Steps — $THEME_NAME
╚═══════════════════════════════════════════════════════════╝

  Apps that need manual theme changes:
  • macOS:     System Settings → Appearance
  • Slack:     Preferences → Themes
  • Firefox:   about:addons → Themes

MANUAL

print_success "Created theme scaffold at themes/$THEME_NAME/"
echo ""
echo "  Next steps:"
echo "  1. Put the palette in colors.toml (or paste an Omarchy colors.toml)"
echo "  2. Fill in theme.conf: nvim_colorscheme, vscode_theme, zed_theme, bat_theme, delta_theme"
echo "  3. Add the nvim plugin spec to nvim/${THEME_NAME}-theme.lua"
echo "  4. Optional: hand-tune any rendered file via overrides/"
echo "  5. Test: dotfiles theme $THEME_NAME"
echo ""
