#!/usr/bin/env bash
# dotfiles:summary=Run user hooks for an event (~/.config/dotfiles/hooks/)
# dotfiles:args=<event> [args...]
set -euo pipefail
# Run user hooks for an event — can be run from anywhere
# Usage: dotfiles-hook <event> [args...]
#
# Hooks live outside the repo so they survive updates:
#   ~/.config/dotfiles/hooks/<event>        a single script (run first)
#   ~/.config/dotfiles/hooks/<event>.d/*    any number of scripts, in order
#
# Events fired by the dotfiles tooling (args in $1...):
#   theme-set <theme>     after `dotfiles theme` finishes
#   post-sync             after `dotfiles sync`
#   post-update           after `dotfiles update`
#
# A failing hook is reported and does not stop the caller.

if [[ -z "${1:-}" || "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "Usage: dotfiles-hook <event> [args...]"
    echo ""
    echo "Runs ~/.config/dotfiles/hooks/<event> and ~/.config/dotfiles/hooks/<event>.d/*"
    echo "Events: theme-set <theme>, post-sync, post-update"
    exit 0
fi

EVENT="$1"
shift
HOOKS_DIR="${DOTFILES_HOOKS_DIR:-$HOME/.config/dotfiles/hooks}"
HOOK_FILE="$HOOKS_DIR/$EVENT"
HOOK_DIR="$HOOK_FILE.d"

if [[ -f "$HOOK_FILE" ]]; then
    bash "$HOOK_FILE" "$@" || echo "Hook failed: $HOOK_FILE" >&2
fi

if [[ -d "$HOOK_DIR" ]]; then
    for hook in "$HOOK_DIR"/*; do
        [[ -f "$hook" ]] || continue
        [[ "$hook" == *.sample ]] && continue
        bash "$hook" "$@" || echo "Hook failed: $hook" >&2
    done
fi
