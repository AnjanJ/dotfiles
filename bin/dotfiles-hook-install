#!/usr/bin/env bash
# dotfiles:summary=Copy a script into ~/.config/dotfiles/hooks/<event>.d/ and make it executable
# dotfiles:args=<event> <file>
#
#   dotfiles hook install theme-set ~/bin/retint-slack.sh
#
# Events: theme-set, post-sync, post-update, post-install, font-set (dotfiles hook
# --help explains each). Any other name is accepted with a warning, for
# events fired by your own scripts. Ported from omarchy-hook-install.
set -euo pipefail

if [[ $# -ne 2 || "$1" == "-h" || "$1" == "--help" ]]; then
    echo "Usage: dotfiles hook install <event> <file>" >&2
    [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && exit 0
    exit 1
fi

EVENT="$1"
FILE="$2"
HOOKS_DIR="${DOTFILES_HOOKS_DIR:-$HOME/.config/dotfiles/hooks}"

if ! (LC_ALL=C; [[ "$EVENT" =~ ^[a-z][a-z0-9-]*$ ]]); then
    echo "Event names are lowercase words with dashes, got '$EVENT'" >&2
    exit 1
fi
case "$EVENT" in
    theme-set|post-sync|post-update|post-install|font-set) ;;
    *) echo "Warning: nothing in the dotfiles tooling fires '$EVENT'; only your own \`dotfiles hook $EVENT\` calls will run it" >&2 ;;
esac
if [[ ! -f "$FILE" ]]; then
    echo "Hook file not found: $FILE" >&2
    exit 1
fi

DEST="$HOOKS_DIR/$EVENT.d/$(basename "$FILE")"
mkdir -p "$HOOKS_DIR/$EVENT.d"
cp "$FILE" "$DEST"
chmod 755 "$DEST"
echo "Installed $EVENT hook: $DEST"
