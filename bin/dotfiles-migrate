#!/usr/bin/env bash
# dotfiles:summary=Run pending one-off migrations
# dotfiles:args=[--pending] [--dry-run] [--new <slug>]
# Run pending migrations — can be run from anywhere
# Usage: dotfiles-migrate [--pending] [--dry-run]
#
# A migration is a one-off, idempotent repair that every machine needs
# after a repo change that install/sync cannot express on their own: a
# symlink that moved, a generated file that changed location, a stale
# config to remove. They live in migrations/<unix-ts>-<slug>.sh and run
# in filename order with DOTFILES_DIR exported; a completed migration is
# marked in ~/.local/state/dotfiles/migrations/<filename> so it never
# runs twice on the same machine. A failing migration stays pending and
# is retried on the next sync/update.
#
# Add one with:  bin/dotfiles-migrate --new <slug>

set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
MIGRATIONS_DIR="$DOTFILES_DIR/migrations"
STATE_DIR="${DOTFILES_STATE_DIR:-$HOME/.local/state/dotfiles}/migrations"

case "${1:-}" in
    --help|-h)
        echo "Usage: dotfiles-migrate [--pending] [--dry-run] [--new <slug>]"
        echo ""
        echo "  (no args)     Run every pending migration"
        echo "  --pending     List pending migrations; exit 0 if any, 1 if none"
        echo "  --dry-run     Show what would run without running it"
        echo "  --new <slug>  Create migrations/<timestamp>-<slug>.sh"
        exit 0
        ;;
    --new)
        slug="${2:-}"
        if [[ ! "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
            echo "Usage: dotfiles-migrate --new <slug>   (lowercase, digits, hyphens)" >&2
            exit 1
        fi
        mkdir -p "$MIGRATIONS_DIR"
        file="$MIGRATIONS_DIR/$(date +%s)-$slug.sh"
        cat > "$file" <<'TEMPLATE'
#!/usr/bin/env bash
# Migration: <describe the one-off repair here>
# Runs once per machine with DOTFILES_DIR exported. Must be idempotent.
set -euo pipefail

TEMPLATE
        echo "Created $file"
        exit 0
        ;;
esac

pending=()
if [[ -d "$MIGRATIONS_DIR" ]]; then
    for m in "$MIGRATIONS_DIR"/*.sh; do
        [[ -f "$m" ]] || continue
        [[ -f "$STATE_DIR/$(basename "$m")" ]] && continue
        pending+=("$m")
    done
fi

if [[ "${1:-}" == "--pending" ]]; then
    for m in ${pending[@]+"${pending[@]}"}; do basename "$m"; done
    [[ ${#pending[@]} -gt 0 ]]
    exit $?
fi

if [[ ${#pending[@]} -eq 0 ]]; then
    echo "No pending migrations"
    exit 0
fi

failed=0
for m in "${pending[@]}"; do
    name=$(basename "$m")
    if [[ "${1:-}" == "--dry-run" ]]; then
        echo "Would run: $name"
        continue
    fi
    echo "==> Migration: $name"
    if DOTFILES_DIR="$DOTFILES_DIR" bash -euo pipefail "$m"; then
        mkdir -p "$STATE_DIR"
        touch "$STATE_DIR/$name"
        echo "    done"
    else
        echo "    FAILED (will retry on next sync/update)" >&2
        failed=$((failed + 1))
    fi
done

[[ $failed -eq 0 ]]
