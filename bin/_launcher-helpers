#!/usr/bin/env bash

# ============================================
# SHARED LAUNCHER HELPERS
# ============================================
# Sourced by: dotfiles-webapp-install, dotfiles-webapp-remove,
#             dotfiles-tui-install, dotfiles-tui-remove
# Not meant to be run directly.
#
# A launcher is a minimal .app bundle in ~/Applications (so Spotlight,
# Raycast and the Dock see it) whose executable is a two-line shell
# script, plus an AeroSpace [[on-window-detected]] rule between the
# DOTFILES_LAUNCHERS_START/END markers in aerospace.toml. The bundle's
# Info.plist carries a DotfilesLauncher key so remove/list can find
# what we made and nothing else.
#
# Bash 3.2 compatible: no associative arrays, no mapfile.
# ============================================

# Resolve symlinks (~/bin/_launcher-helpers -> repo/bin/_launcher-helpers)
DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}"
source "$DOTFILES_DIR/scripts/_helpers.sh"

LAUNCHER_APPS_DIR="${DOTFILES_LAUNCHER_APPS_DIR:-$HOME/Applications}"
AEROSPACE_CONFIG="$DOTFILES_DIR/.config/aerospace/aerospace.toml"
LAUNCHER_MARK_START="# DOTFILES_LAUNCHERS_START"
LAUNCHER_MARK_END="# DOTFILES_LAUNCHERS_END"

# ── Names ─────────────────────────────────────

# The name becomes a bundle directory, a bundle id segment and a rule
# marker. A slash would nest the bundle somewhere remove cannot address;
# a leading dot hides it. Refuse rather than silently rename.
launcher_require_plain_name() {
    local name="$1"
    if [[ -z "$name" || "$name" == */* || "$name" == .* || "$name" == *$'\n'* ]]; then
        print_error "Name must be non-empty and contain no '/' (got: '$name')"
        return 1
    fi
}

# "Proton Mail" -> proton-mail
launcher_slug() {
    printf '%s\n' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^[:alnum:]]+/-/g; s/^-//; s/-$//'
}

launcher_bundle_path() {
    echo "$LAUNCHER_APPS_DIR/$1.app"
}

# ── Bundle ────────────────────────────────────

# Escape for a plist <string>
_launcher_xml_escape() {
    local v="$1"
    v="${v//&/&amp;}"; v="${v//</&lt;}"; v="${v//>/&gt;}"; v="${v//\"/&quot;}"
    printf '%s' "$v"
}

# launcher_write_bundle <name> <kind: webapp|tui> <payload> <launch script body> [icon.icns]
# Replaces an existing bundle of the same name. <payload> is the URL or
# command, recorded so list/remove can show it.
launcher_write_bundle() {
    local name="$1" kind="$2" payload="$3" script_body="$4" icns="${5:-}"
    local app slug
    app="$(launcher_bundle_path "$name")"
    slug="$(launcher_slug "$name")"

    rm -rf "$app"
    mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"

    printf '#!/bin/bash\n# Generated by dotfiles %s install; edit with that command, not here.\n%s\n' \
        "$kind" "$script_body" > "$app/Contents/MacOS/launch"
    chmod +x "$app/Contents/MacOS/launch"

    local icon_key=""
    if [[ -n "$icns" && -f "$icns" ]]; then
        cp "$icns" "$app/Contents/Resources/icon.icns"
        icon_key="    <key>CFBundleIconFile</key>
    <string>icon</string>
"
    fi

    cat > "$app/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>$(_launcher_xml_escape "$name")</string>
    <key>CFBundleDisplayName</key>
    <string>$(_launcher_xml_escape "$name")</string>
    <key>CFBundleIdentifier</key>
    <string>com.dotfiles.$kind.$slug</string>
    <key>CFBundleExecutable</key>
    <string>launch</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>12.0</string>
$icon_key    <key>DotfilesLauncher</key>
    <string>$kind</string>
    <key>DotfilesPayload</key>
    <string>$(_launcher_xml_escape "$payload")</string>
</dict>
</plist>
EOF

    # LaunchServices registers new bundles lazily; until it has, `open -a
    # Name` and Spotlight cannot find the app. Register it now (best
    # effort: the tool is a private path, and a sandboxed test has no
    # LaunchServices to talk to).
    local lsregister=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
    [[ -x "$lsregister" && -z "${DOTFILES_LAUNCHER_NO_REGISTER:-}" ]] && "$lsregister" -f "$app" >/dev/null 2>&1 || true
}

# launcher_bundle_kind <app path> -> webapp|tui, or nothing if not ours
launcher_bundle_kind() {
    /usr/libexec/PlistBuddy -c 'Print DotfilesLauncher' "$1/Contents/Info.plist" 2>/dev/null || true
}

# launcher_list <kind> -> "<name>\t<payload>" per line
launcher_list() {
    local kind="$1" app name
    for app in "$LAUNCHER_APPS_DIR"/*.app; do
        [[ -d "$app" ]] || continue
        [[ "$(launcher_bundle_kind "$app")" == "$kind" ]] || continue
        name="$(basename "$app" .app)"
        printf '%s\t%s\n' "$name" "$(/usr/libexec/PlistBuddy -c 'Print DotfilesPayload' "$app/Contents/Info.plist" 2>/dev/null || true)"
    done
}

# ── Icons ─────────────────────────────────────

# launcher_make_icns <png-or-any-image> <out.icns>
# sips and iconutil ship with macOS. Returns 1 (quietly) if the source
# is not an image sips can read; callers treat a missing icon as cosmetic.
launcher_make_icns() {
    local src="$1" out="$2"
    local iconset size
    iconset="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-iconset.XXXXXX")/icon.iconset"
    mkdir -p "$iconset"
    # Normalise to a 1024px PNG first so odd inputs (ico, jpeg, svg-less
    # favicons) either convert or fail here rather than halfway through.
    if ! sips -s format png -z 1024 1024 "$src" --out "$iconset/base.png" >/dev/null 2>&1; then
        rm -rf "$(dirname "$iconset")"
        return 1
    fi
    for size in 16 32 128 256 512; do
        sips -z "$size" "$size" "$iconset/base.png" --out "$iconset/icon_${size}x${size}.png" >/dev/null 2>&1
        sips -z "$((size * 2))" "$((size * 2))" "$iconset/base.png" --out "$iconset/icon_${size}x${size}@2x.png" >/dev/null 2>&1
    done
    rm -f "$iconset/base.png"
    if iconutil -c icns "$iconset" -o "$out" 2>/dev/null; then
        rm -rf "$(dirname "$iconset")"
        return 0
    fi
    rm -rf "$(dirname "$iconset")"
    return 1
}

# launcher_download <url> <dest>: only an actual image counts
launcher_download() {
    curl -fsSL --max-time 10 -o "$2" "$1" 2>/dev/null \
        && [[ -s "$2" ]] && [[ "$(file -b --mime-type "$2")" == image/* ]]
}

# launcher_fetch_site_icon <site url> <dest>
# The site's apple-touch-icon (usually 180px+), then the well-known
# path, then Google's favicon service as a last resort.
launcher_fetch_site_icon() {
    local site_url="$1" dest="$2"
    local origin page icon_url=""
    origin=$(printf '%s' "$site_url" | sed -E 's|^(https?://[^/]+).*|\1|')
    page=$(curl -fsSL --max-time 5 "$site_url" 2>/dev/null | head -c 100000 | tr '\n' ' ')
    icon_url=$(printf '%s' "$page" \
        | /usr/bin/grep -oiE "<link[^>]*rel=[\"'][^\"']*apple-touch-icon[^\"']*[\"'][^>]*>" \
        | /usr/bin/grep -oiE "href=[\"'][^\"']+" | head -1 | sed -E "s/^href=[\"']//")
    case "$icon_url" in
        http://*|https://*) ;;
        //*) icon_url="https:$icon_url" ;;
        /*) icon_url="$origin$icon_url" ;;
        ?*) icon_url="$origin/$icon_url" ;;
    esac
    { [[ -n "$icon_url" ]] && launcher_download "$icon_url" "$dest"; } \
        || launcher_download "$origin/apple-touch-icon.png" "$dest" \
        || launcher_download "https://www.google.com/s2/favicons?domain=${origin#*://}&sz=256" "$dest"
}

# launcher_resolve_icon <icon ref: url|path|""> <site url or ""> <out.icns>
# Prints nothing; returns 0 when out.icns exists.
launcher_resolve_icon() {
    local ref="$1" site="$2" out="$3"
    local tmp
    tmp="$(mktemp "${TMPDIR:-/tmp}/dotfiles-icon.XXXXXX")"
    if [[ "$ref" =~ ^https?:// ]]; then
        launcher_download "$ref" "$tmp" || { rm -f "$tmp"; return 1; }
    elif [[ -n "$ref" ]]; then
        [[ -f "$ref" ]] || { rm -f "$tmp"; return 1; }
        cp "$ref" "$tmp"
    elif [[ -n "$site" ]]; then
        launcher_fetch_site_icon "$site" "$tmp" || { rm -f "$tmp"; return 1; }
    else
        rm -f "$tmp"
        return 1
    fi
    launcher_make_icns "$tmp" "$out"
    local rc=$?
    rm -f "$tmp"
    return "$rc"
}

# ── AeroSpace rules ───────────────────────────

# Make sure the marker block exists; older configs get it inserted just
# before the first [[on-window-detected]] so launcher rules still win.
_launcher_ensure_markers() {
    /usr/bin/grep -qF "$LAUNCHER_MARK_START" "$AEROSPACE_CONFIG" && return 0
    local tmp
    tmp="$(mktemp "${TMPDIR:-/tmp}/aerospace.XXXXXX")"
    awk -v s="$LAUNCHER_MARK_START" -v e="$LAUNCHER_MARK_END" '
        !done && /^\[\[on-window-detected\]\]/ { print s; print e; print ""; done=1 }
        { print }
        END { if (!done) { print ""; print s; print e } }
    ' "$AEROSPACE_CONFIG" > "$tmp" && mv "$tmp" "$AEROSPACE_CONFIG"
}

# launcher_rule_remove <kind> <name>: drop the block for this launcher
launcher_rule_remove() {
    local kind="$1" name="$2" tmp
    tmp="$(mktemp "${TMPDIR:-/tmp}/aerospace.XXXXXX")"
    awk -v begin="# dotfiles-$kind: $name (begin)" -v end="# dotfiles-$kind: $name (end)" '
        $0 == begin { skip=1; next }
        $0 == end   { skip=0; next }
        !skip { print }
    ' "$AEROSPACE_CONFIG" > "$tmp" && mv "$tmp" "$AEROSPACE_CONFIG"
}

# launcher_rule_add <kind> <name> <app-id> <title regex> <float: true|false> <workspace or "">
# Writes (replacing any previous block for the name) inside the markers:
#   [[on-window-detected]]
#   if.app-id = '<app-id>'
#   if.window-title-regex-substring = '<regex>'
#   run = ['layout floating', 'move-node-to-workspace N']
launcher_rule_add() {
    local kind="$1" name="$2" app_id="$3" regex="$4" float="$5" workspace="$6"
    local run="" tmp
    [[ "$float" == true ]] && run="'layout floating'"
    if [[ -n "$workspace" ]]; then
        [[ -n "$run" ]] && run="$run, "
        run="$run'move-node-to-workspace $workspace'"
    fi
    [[ -n "$run" ]] || return 0   # nothing to place: no rule needed

    _launcher_ensure_markers
    launcher_rule_remove "$kind" "$name"
    # TOML literal strings cannot contain a single quote; a regex with one
    # is an odd enough request to refuse rather than mangle.
    if [[ "$regex" == *"'"* ]]; then
        print_error "Title pattern cannot contain a single quote"
        return 1
    fi
    tmp="$(mktemp "${TMPDIR:-/tmp}/aerospace.XXXXXX")"
    awk -v end="$LAUNCHER_MARK_END" -v kind="$kind" -v name="$name" -v app="$app_id" -v re="$regex" -v run="$run" '
        $0 == end {
            print "# dotfiles-" kind ": " name " (begin)"
            print "[[on-window-detected]]"
            print "if.app-id = '"'"'" app "'"'"'"
            print "if.window-title-regex-substring = '"'"'" re "'"'"'"
            print "run = [" run "]"
            print "# dotfiles-" kind ": " name " (end)"
        }
        { print }
    ' "$AEROSPACE_CONFIG" > "$tmp" && mv "$tmp" "$AEROSPACE_CONFIG"
}

launcher_reload_aerospace() {
    bash "$DOTFILES_DIR/bin/dotfiles-restart" aerospace >/dev/null 2>&1 || true
}
