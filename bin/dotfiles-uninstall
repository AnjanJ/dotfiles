#!/usr/bin/env bash
# dotfiles:summary=Remove every managed symlink (keeps repo and packages)
# dotfiles:args=[--yes]
# Remove all dotfiles symlinks — can be run from anywhere
# Usage: dotfiles-uninstall [--yes]
#
# This removes symlinks only. It does NOT:
#   - Delete the dotfiles repo
#   - Uninstall Homebrew packages
#   - Remove language runtimes

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "Usage: dotfiles-uninstall [--yes]"
    echo ""
    echo "Remove all dotfiles symlinks. Does NOT uninstall packages or runtimes."
    echo ""
    echo "Options:"
    echo "  --yes   Skip confirmation prompt"
    exit 0
fi

set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
source "$DOTFILES_DIR/scripts/_helpers.sh"
source "$DOTFILES_DIR/scripts/symlink-map.sh"

FORCE=false
[[ "${1:-}" == "--yes" ]] && FORCE=true

echo ""
echo ""
echo "  AJ's Dotfiles Uninstall"
echo "  =========================================="
echo ""
echo "  This will remove all symlinks created by dotfiles."
echo "  Your Homebrew packages and runtimes stay untouched."
echo ""

# Collect all symlinks that point into our dotfiles dir
REMOVED=0
SKIPPED=0

remove_symlink() {
    local target="$1"
    local name="$2"

    if [ -L "$target" ]; then
        local link_target
        link_target=$(readlink "$target")
        # Only remove if it points to our dotfiles dir
        if [[ "$link_target" == "$DOTFILES_DIR"* ]]; then
            rm "$target"
            echo -e "${GREEN}✓${NC} Removed $name → $link_target"
            REMOVED=$((REMOVED + 1))
        else
            echo -e "${YELLOW}⚠${NC} Skipped $name (points to $link_target, not our dotfiles)"
            SKIPPED=$((SKIPPED + 1))
        fi
    fi
}

if [[ "$FORCE" != true ]]; then
    echo "The following symlinks will be removed:"
    echo ""

    # Preview what would be removed — every link in scripts/symlink-map.sh
    PREVIEW_COUNT=0
    _preview_managed_link() {
        local target="$2"
        if [ -L "$target" ]; then
            local link_target
            link_target=$(readlink "$target")
            if [[ "$link_target" == "$DOTFILES_DIR"* ]]; then
                echo "  $target → $link_target"
                PREVIEW_COUNT=$((PREVIEW_COUNT + 1))
            fi
        fi
    }
    dotfiles_for_each_link _preview_managed_link

    echo ""
    echo "$PREVIEW_COUNT symlinks will be removed."
    echo ""
    read -r -p "Continue? (y/n) " -n 1
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        print_warning "Uninstall cancelled"
        exit 1
    fi
fi

echo ""
print_step "Removing symlinks..."

# Walk the same map install/update/sync/doctor/health use, so a link
# added to the repo can never be left behind by uninstall.
_remove_managed_link() {
    remove_symlink "$2" "$3"
}
dotfiles_for_each_link _remove_managed_link

# Summary
echo ""
echo ""
echo "  =========================================="
echo "  Uninstall Complete!"
echo "  =========================================="
echo ""
echo -e "${GREEN}Removed:${NC} $REMOVED symlinks"
[[ $SKIPPED -gt 0 ]] && echo -e "${YELLOW}Skipped:${NC} $SKIPPED (not ours)"
echo ""
echo "Your dotfiles repo is still at: $DOTFILES_DIR"
echo "To reinstall: dotfiles install (or bash $DOTFILES_DIR/install.sh)"
echo ""
