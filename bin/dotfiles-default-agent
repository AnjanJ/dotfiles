#!/usr/bin/env bash
# dotfiles:summary=Show or set the default AI agent that the `a` shell function launches
# dotfiles:args=[claude|oclaude|gemini|copilot|llm] [--command]
#
# Default AI agent — can be run from anywhere
# Usage: dotfiles default-agent            # show the current default
#        dotfiles default-agent claude     # set it
#        dotfiles default-agent --command  # print the launch command (used by `a`)
#
# The choice lives in ~/.local/state/dotfiles/default-agent so it is
# per-machine and survives updates. `a` in .zshrc runs whatever this says.

set -euo pipefail

STATE_FILE="${DOTFILES_STATE_DIR:-$HOME/.local/state/dotfiles}/default-agent"
DEFAULT="claude"

# agent → launch command. Permission modes are scoped, never skipped:
# auto-approve edits within the project, still confirm the dangerous stuff.
agent_command() {
    case "$1" in
        claude)  echo "claude --permission-mode auto" ;;
        oclaude) echo "oclaude" ;;                       # Claude Code via Ollama (.zshrc)
        gemini)  echo "gemini --approval-mode auto_edit" ;;
        copilot) echo "gh copilot" ;;
        llm)     echo "llm chat" ;;
        *) return 1 ;;
    esac
}
KNOWN="claude oclaude gemini copilot llm"

current() {
    if [[ -f "$STATE_FILE" ]]; then cat "$STATE_FILE"; else echo "$DEFAULT"; fi
}

case "${1:-}" in
    --help|-h)
        echo "Usage: dotfiles default-agent [claude|oclaude|gemini|copilot|llm] [--command]"
        echo ""
        echo "  (no args)   show the current default"
        echo "  <name>      set the default"
        echo "  --command   print the launch command for the current default"
        echo "  --list      list known agents"
        exit 0
        ;;
    --list)
        for a in $KNOWN; do
            marker=" "
            [[ "$a" == "$(current)" ]] && marker="*"
            printf ' %s %-8s %s\n' "$marker" "$a" "$(agent_command "$a")"
        done
        exit 0
        ;;
    --command)
        agent_command "$(current)"
        exit 0
        ;;
    "")
        current
        exit 0
        ;;
    *)
        if ! agent_command "$1" >/dev/null; then
            echo "Unknown agent '$1'. Known: $KNOWN" >&2
            exit 1
        fi
        mkdir -p "$(dirname "$STATE_FILE")"
        echo "$1" > "$STATE_FILE"
        echo "Default agent: $1  ($(agent_command "$1"))"
        ;;
esac
