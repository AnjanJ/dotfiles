#!/usr/bin/env bash
# dotfiles:summary=List the packages kept in your personal tap and any dropped ones still waiting for an answer
#
# Shows the tap's name, the repo folder holding its recipes and Homebrew's
# working copy, then every package
# it carries with the installed version. Packages Homebrew dropped that you
# skipped (or that an unattended update only listed) follow; the next
# `dotfiles update` in a terminal asks about them.

set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
source "$DOTFILES_DIR/scripts/personal-tap.sh"

STATE_DIR="${DOTFILES_STATE_DIR:-$HOME/.local/state/dotfiles}"
PENDING="$STATE_DIR/tap-pending"

for arg in "$@"; do
    echo "Unknown option: $arg" >&2
    exit 2
done

TAP=$(ptap_name)
if ptap_exists; then
    echo "Tap:     $TAP"
    echo "Recipes: $(ptap_src)"
    echo "Homebrew's copy: $(ptap_dir)"
    case "$(cat "$STATE_DIR/tap-install" 2>/dev/null || true)" in
        yes) echo "This machine: installs kept packages" ;;
        no) echo "This machine: does not install kept packages (rm $STATE_DIR/tap-install to be asked again)" ;;
        *) echo "This machine: not asked yet (dotfiles update asks when a kept package is missing here)" ;;
    esac
    packages=$(ptap_packages)
    if [[ -z "$packages" ]]; then
        echo "No packages kept yet"
    else
        while read -r kind name; do
            if [[ "$kind" == cask ]]; then
                version=$(brew list --cask --versions "$name" 2>/dev/null | awk '{print $2}' || true)
            else
                version=$(brew list --formula --versions "$name" 2>/dev/null | awk '{print $2}' || true)
            fi
            printf '  %-8s %-28s %s\n' "$kind" "$name" "${version:-not installed}"
        done <<<"$packages"
    fi
else
    echo "No personal tap yet ($TAP); dotfiles update creates it the first time you keep a package Homebrew dropped"
fi

if [[ -s "$PENDING" ]]; then
    echo ""
    echo "Dropped by Homebrew, waiting for keep or remove (run: dotfiles update):"
    sed 's/^/  /' "$PENDING"
fi
exit 0
