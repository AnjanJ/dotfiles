#!/usr/bin/env bash
# dotfiles:summary=Discoverable menu over every dotfiles verb (fzf tree: theme, toggles, launchers, update…)
# dotfiles:args=[route] [--list | --run <label>]
#
#   dotfiles menu                 # top level, pick with fzf (numbered prompt without it)
#   dotfiles menu theme           # open a submenu directly
#   dotfiles menu toggle --list   # print the rows: label<TAB>command
#   dotfiles menu theme --run "Switch to aura"
#
# Every row is a shell command, so anything the menu can do you can
# script; a row ending in ▸ opens a submenu. Ctrl+Shift+Space opens it
# in a Ghostty window (aerospace.toml); `dotfiles tui install Menu
# "dotfiles menu"` makes it a floating app instead. Modelled on
# Omarchy's Super+Space menu (Style / Setup / Install / Update).
#
# DOTFILES_MENU_DRY=1 prints the chosen command instead of running it
# (tests); DOTFILES_MENU_HOLD=1 waits for Enter after a command so a
# window opened just for the menu shows the output before closing.

set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
source "$DOTFILES_DIR/scripts/theme-utils.sh"

SUB="▸"

# ── Rows: label<TAB>command, one per line ─────────────────────
# A command of "menu:<route>" descends.

rows_root() {
    printf '%s\t%s\n' \
        "Theme $SUB" "menu:theme" \
        "Toggles $SUB" "menu:toggle" \
        "Launchers $SUB" "menu:launchers" \
        "Reminder $SUB" "menu:reminder" \
        "Keybinding cheatsheet" "dotfiles keys" \
        "Health check" "dotfiles health" \
        "Doctor (auto-fix)" "dotfiles doctor" \
        "Sync (pull, relink, migrate, re-theme)" "dotfiles sync" \
        "Update (brew, mise, relink, snapshot commit)" "dotfiles update" \
        "Backup managed files" "dotfiles backup" \
        "All commands $SUB" "menu:commands"
}

rows_theme() {
    local current theme mode mark
    current="$(get_current_theme)"
    for theme in ${VALID_THEMES[@]+"${VALID_THEMES[@]}"}; do
        mode="$(sed -n 's/^mode *= *"\([a-z]*\)".*/\1/p' "$DOTFILES_DIR/themes/$theme/colors.toml" 2>/dev/null | head -1)"
        mark="  "
        [[ "$theme" == "$current" ]] && mark="* "
        printf '%s\t%s\n' "${mark}Switch to $theme${mode:+ ($mode)}" "dotfiles theme $theme"
    done
    printf '%s\t%s\n' \
        "Background: next" "dotfiles theme bg next" \
        "Background: list" "dotfiles theme bg list" \
        "Background: open my folder" "dotfiles theme bg dir" \
        "Add a theme (scaffold)" "menu:prompt:add-theme"
}

rows_toggle() {
    local flag state
    while read -r flag state; do
        [[ -n "$flag" ]] || continue
        printf '%s\t%s\n' "$flag: $state" "dotfiles toggle $flag toggle"
    done < <("$DOTFILES_DIR/bin/dotfiles-toggle" --list)
}

rows_launchers() {
    local name payload
    printf '%s\t%s\n' \
        "Install a web app (Chrome --app)" "menu:prompt:webapp" \
        "Install a TUI (Ghostty launcher)" "menu:prompt:tui"
    while IFS=$'\t' read -r name payload; do
        [[ -n "$name" ]] || continue
        printf '%s\t%s\n' "Remove web app: $name ($payload)" "dotfiles webapp remove \"$name\""
    done < <("$DOTFILES_DIR/bin/dotfiles-webapp-remove" --list 2>/dev/null | sed -E 's/^  ([^ ].*[^ ]) +([^ ]+)$/\1\t\2/' || true)
    while IFS=$'\t' read -r name payload; do
        [[ -n "$name" ]] || continue
        printf '%s\t%s\n' "Remove TUI: $name ($payload)" "dotfiles tui remove \"$name\""
    done < <("$DOTFILES_DIR/bin/dotfiles-tui-remove" --list 2>/dev/null | sed -E 's/^  ([^ ].*[^ ]) +([^ ]+)$/\1\t\2/' || true)
}

rows_reminder() {
    printf '%s\t%s\n' \
        "In 5 minutes" "dotfiles reminder 5" \
        "In 15 minutes" "dotfiles reminder 15" \
        "In 25 minutes (pomodoro)" "dotfiles reminder 25 \"Pomodoro done\"" \
        "In 60 minutes" "dotfiles reminder 60" \
        "Custom…" "menu:prompt:reminder" \
        "Show pending" "dotfiles reminder show" \
        "Clear all" "dotfiles reminder clear"
}

rows_commands() {
    local route summary
    while IFS=$'\t' read -r route summary _; do
        [[ -n "$route" ]] || continue
        printf '%s\t%s\n' "$route — $summary" "dotfiles $route"
    done < <("$DOTFILES_DIR/bin/dotfiles" commands --plain)
}

rows_for() {
    case "$1" in
        root|"") rows_root ;;
        theme) rows_theme ;;
        toggle|toggles) rows_toggle ;;
        launchers) rows_launchers ;;
        reminder) rows_reminder ;;
        commands) rows_commands ;;
        *) return 1 ;;
    esac
}

# ── Prompts for the few rows that need input ──────────────────
prompt_command() {
    local what="$1" name url cmd minutes msg
    case "$what" in
        webapp)
            read -r -p "Name: " name
            read -r -p "URL: " url
            [[ -n "$name" && -n "$url" ]] || return 1
            echo "dotfiles webapp install \"$name\" \"$url\" --float"
            ;;
        tui)
            read -r -p "Name: " name
            read -r -p "Command: " cmd
            [[ -n "$name" && -n "$cmd" ]] || return 1
            echo "dotfiles tui install \"$name\" \"$cmd\""
            ;;
        reminder)
            read -r -p "Minutes: " minutes
            read -r -p "Message (optional): " msg
            [[ "$minutes" =~ ^[0-9]+$ ]] || return 1
            echo "dotfiles reminder $minutes${msg:+ \"$msg\"}"
            ;;
        add-theme)
            read -r -p "Theme name: " name
            [[ -n "$name" ]] || return 1
            echo "dotfiles add-theme \"$name\""
            ;;
        *) return 1 ;;
    esac
}

run_command() {
    local cmd="$1"
    if [[ -n "${DOTFILES_MENU_DRY:-}" ]]; then
        echo "$cmd"
        return 0
    fi
    # Commands are built from this file and the repo's own listings, not
    # from user text, so eval is the plain way to honour their quoting.
    eval "$cmd" || true
    if [[ -n "${DOTFILES_MENU_HOLD:-}" ]]; then
        echo ""
        read -r -p "Press Enter to close" _
    fi
}

command_for_label() {
    local route="$1" label="$2" l c
    while IFS=$'\t' read -r l c; do
        [[ "$l" == "$label" ]] && { echo "$c"; return 0; }
    done < <(rows_for "$route")
    return 1
}

# ── Interactive ───────────────────────────────────────────────
pick() {
    # $1 route; prints the chosen label, empty on cancel
    local route="$1" labels
    labels="$(rows_for "$route" | cut -f1)"
    [[ -n "$labels" ]] || return 1
    if command -v fzf >/dev/null 2>&1 && [[ -z "${DOTFILES_MENU_NO_FZF:-}" ]]; then
        printf '%s\n' "$labels" | fzf --prompt "dotfiles $SUB ${route} > " --height 40% --reverse --no-info || true
    else
        local i=1 choice
        echo "dotfiles $SUB $route" >&2
        while IFS= read -r l; do
            printf '  %2d) %s\n' "$i" "$l" >&2
            i=$((i + 1))
        done <<< "$labels"
        read -r -p "Choice (Enter to cancel): " choice
        if [[ "$choice" =~ ^[0-9]+$ ]]; then
            printf '%s\n' "$labels" | sed -n "${choice}p"
        fi
    fi
    return 0
}

interactive() {
    local route="$1" label cmd
    while :; do
        label="$(pick "$route")" || { echo "Nothing to show for '$route'" >&2; return 1; }
        [[ -n "$label" ]] || return 0
        cmd="$(command_for_label "$route" "$label")" || return 1
        case "$cmd" in
            menu:prompt:*) cmd="$(prompt_command "${cmd#menu:prompt:}")" || continue; run_command "$cmd"; return 0 ;;
            menu:*) route="${cmd#menu:}" ;;
            *) run_command "$cmd"; return 0 ;;
        esac
    done
}

# ── Dispatch ──────────────────────────────────────────────────
ROUTE="root"
MODE="interactive"
LABEL=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --list) MODE="list"; shift ;;
        --run) MODE="run"; LABEL="${2:-}"; shift 2 ;;
        -h|--help) sed -n '3,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*) echo "Unknown option: $1" >&2; exit 1 ;;
        *) ROUTE="$1"; shift ;;
    esac
done

rows_for "$ROUTE" >/dev/null 2>&1 || { echo "Unknown menu '$ROUTE' (root, theme, toggle, launchers, reminder, commands)" >&2; exit 1; }

case "$MODE" in
    list) rows_for "$ROUTE" ;;
    run)
        cmd="$(command_for_label "$ROUTE" "$LABEL")" || { echo "No row '$LABEL' in menu '$ROUTE'" >&2; exit 1; }
        case "$cmd" in
            menu:prompt:*) cmd="$(prompt_command "${cmd#menu:prompt:}")" || exit 1 ;;
            menu:*) echo "'$LABEL' opens the '${cmd#menu:}' menu; run: dotfiles menu ${cmd#menu:}"; exit 0 ;;
        esac
        run_command "$cmd"
        ;;
    interactive) interactive "$ROUTE" ;;
esac
