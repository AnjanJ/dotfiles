[core]
	# Fallback when $GIT_EDITOR is unset (GUI apps); the shell exports
	# GIT_EDITOR from .zshrc, which wins in a terminal.
	editor = nvim
	excludesfile = ~/.gitignore_global
	pager = delta
[pull]
	# A pull that cannot fast-forward stops instead of making a merge
	# commit; rebase or merge on purpose.
	ff = only
[fetch]
	prune = true
[rebase]
	autoStash = true
[diff]
	algorithm = histogram
[rerere]
	enabled = true
[push]
	autoSetupRemote = true
[branch]
	sort = -committerdate
[commit]
	verbose = true
[merge]
	tool = nvimdiff
	conflictstyle = zdiff3
[user]
	name = Anjan Jagirdar
	email = anjan.jagirdar@gmail.com
[interactive]
	diffFilter = delta --color-only

[include]
	# delta.syntax-theme, rendered per theme by `dotfiles theme`
	path = ~/.local/state/dotfiles/current/theme/delta.gitconfig
[delta]
	navigate = true          # n / N jump between files in a diff
	line-numbers = true
	hyperlinks = true        # clickable file:line in supporting terminals
	side-by-side = false     # flip to true if you prefer split view
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[gpg]
	format = ssh
[gpg "ssh"]
	# 1Password signs with the key it holds; nothing signs unless
	# commit.gpgsign is on, which ~/.gitconfig.local sets per machine.
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign

# Per-machine settings that must not be public or shared: the signing
# key and commit.gpgsign. Last, so it overrides anything above; git skips
# it when the file does not exist.
[include]
	path = ~/.gitconfig.local
