#!/usr/bin/env bash
# Stops a commit that would publish a private word: a project, client or
# host name, a person, anything in the committer's private-words lists.
# The repo is public, and GitHub's secret scanning only knows token
# formats, so names have no other guard.
#
#   private-words staged             the staged added lines and file names
#   private-words message <file>     a commit message (comment lines skipped)
#   private-words range <base> <head>  what a branch adds: the lines and
#                                    file names of base...head and the
#                                    messages of base..head (CI, PRs)
#
# Run by scripts/git-hooks/pre-commit and commit-msg, which this repo uses
# through core.hooksPath (set by a migration), and by CI on pull requests
# with the list from a repository secret. DOTFILES_PRIVATE_WORDS_QUIET=1
# reports only where a word is (file:line, file name, commit), never the
# line itself, for logs that others can read. The lists, all optional and
# all read together:
#   ~/.config/dotfiles/private-words      your own ($DOTFILES_PRIVATE_WORDS)
#   ~/.config/dotfiles/private-words.d/*  shared ones, e.g. a team list
#                                         linked in from a private repo
#                                         ($DOTFILES_PRIVATE_WORDS_DIR)
# One word or phrase per line, matched case-insensitively anywhere in a
# line; blank lines and lines starting with # are ignored. The lists live
# outside the repo, since they are private themselves, and every person
# or machine keeps their own. No list, no check.
#
# Removing a private word is always allowed: only added lines count.
# A deliberate exception: git commit --no-verify.
# Bash 3.2 compatible: GUI Git clients run hooks with /bin/bash.
set -euo pipefail

config="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles"
lists=()
f="${DOTFILES_PRIVATE_WORDS:-$config/private-words}"
[[ -f "$f" ]] && lists+=("$f")
for f in "${DOTFILES_PRIVATE_WORDS_DIR:-$config/private-words.d}"/*; do
    # Regular files and links to them; editor backups and dotfiles skipped.
    case "$(basename "$f")" in .*|*~|*.swp|*.bak) continue ;; esac
    [[ -f "$f" ]] && lists+=("$f")
done
[[ ${#lists[@]} -gt 0 ]] || exit 0
words=$(sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "${lists[@]}" | grep -vE '^(#|$)' || true)
[[ -n "$words" ]] || exit 0

# Each candidate is "<where>\t<text>": where is "file:line", "file (name)"
# or "commit <sha>"; the match runs on both, the report can omit the text.
added_lines() {
    # Unified diff with -U0 on stdin: every added line with its new number.
    awk '
        /^\+\+\+ /   { f = substr($0, 7); next }
        /^@@ /       { n = $3; sub(/^\+/, "", n); sub(/,.*/, "", n); n += 0; next }
        /^\+/        { print f ":" n "\t" substr($0, 2); n++ }
    '
}
file_names() { while IFS= read -r p; do printf '%s (name)\t%s\n' "$p" "$p"; done; }

case "${1:-}" in
    staged)
        text=$(
            git diff --cached --no-color --no-ext-diff -U0 | added_lines
            git diff --cached --name-only --diff-filter=ACR | file_names
        )
        what="the staged changes contain"
        ;;
    message)
        [[ -f "${2:-}" ]] || { echo "private-words: no message file" >&2; exit 2; }
        # `git commit -v` appends the diff below a scissors line; git
        # drops it from the message, so stop there.
        text=$(awk '/^# -+ >8 -+$/{exit} !/^#/{print "message\t" $0}' "$2")
        what="the commit message contains"
        ;;
    range)
        [[ -n "${2:-}" && -n "${3:-}" ]] || { echo "Usage: private-words range <base> <head>" >&2; exit 2; }
        base="$2" head="$3"
        text=$(
            git diff --no-color --no-ext-diff -U0 "$base...$head" | added_lines
            git diff --name-only --diff-filter=ACR "$base...$head" | file_names
            for c in $(git rev-list "$base..$head"); do
                git log -1 --format=%B "$c" | sed "s/^/commit ${c:0:7}\t/"
            done
        )
        what="the changes from $base to $head contain"
        advice="Remove the word in a new commit (or rewrite the branch) and push again."
        ;;
    *)
        echo "Usage: private-words staged | message <file> | range <base> <head>" >&2
        exit 2
        ;;
esac

advice="${advice:-Remove the word, or, if it is meant to be public, commit with --no-verify.}"

hits=$(printf '%s\n' "$text" | grep -i -F -- "$words" || true)
[[ -z "$hits" ]] && exit 0

{
    echo "private-words: stopped. $what a word from your private-words lists:"
    printf '  (%s)\n' "${lists[@]}"
    if [[ -n "${DOTFILES_PRIVATE_WORDS_QUIET:-}" ]]; then
        printf '%s\n' "$hits" | cut -f1 | sort -u | sed 's/^/  /'
    else
        printf '%s\n' "$hits" | awk -F'\t' '{ print "  " $1 ": " substr($0, length($1) + 2) }' | cut -c1-200
    fi
    echo "This repo is public. $advice"
} >&2
exit 1
