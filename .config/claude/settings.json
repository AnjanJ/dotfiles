{
  "permissions": {
    "allow": [],
    "deny": [
      "Read(**/.env*)",
      "Read(**/.pem)",
      "Read(**/.key)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5[1m]",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": false,
    "shipkit@shipkit": true,
    "ruby-lsp@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": true,
    "bodhikit@bodhikit": true,
    "warp@claude-code-warp": false
  },
  "extraKnownMarketplaces": {
    "shipkit": {
      "source": {
        "source": "git",
        "url": "git@github.com:AnjanJ/shipkit.git"
      }
    },
    "bodhikit": {
      "source": {
        "source": "git",
        "url": "git@github.com:AnjanJ/bodhikit.git"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    }
  },
  "alwaysThinkingEnabled": false,
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "skipAutoPermissionPrompt": true
}
