{
  "cleanupPeriodDays": 365,
  "permissions": {
    "allow": [],
    "deny": [
      "Read(**/.env*)",
      "Read(**/.pem)",
      "Read(**/.key)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)"
    ],
    "defaultMode": "auto"
  },
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "300000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "shipkit@shipkit": true,
    "bodhikit@bodhikit": true,
    "shipkit-workflows@shipkit": true,
    "marketing@synced": false,
    "engineering@synced": false,
    "sales@synced": false,
    "design@synced": false,
    "legal@synced": false,
    "product-management@synced": false,
    "cowork-plugin-management@synced": false,
    "ruby-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "shipkit": {
      "source": {
        "source": "git",
        "url": "git@github.com:AnjanJ/shipkit.git"
      }
    },
    "bodhikit": {
      "source": {
        "source": "git",
        "url": "git@github.com:AnjanJ/bodhikit.git"
      }
    }
  },
  "alwaysThinkingEnabled": false,
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "custom:dotfiles",
  "switchModelsOnFlag": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
