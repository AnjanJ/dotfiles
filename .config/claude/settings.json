{
  "cleanupPeriodDays": 365,
  "permissions": {
    "allow": [],
    "deny": [
      "Read(**/.env*)",
      "Read(**/.pem)",
      "Read(**/.key)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "SendFeedback",
      "ScheduleWakeup",
      "ListAgents"
    ],
    "defaultMode": "auto"
  },
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "200000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "shipkit@shipkit": true,
    "bodhikit@bodhikit": false,
    "bodhikit@synced": false,
    "shipkit@synced": false,
    "shipkit-workflows@shipkit": true,
    "marketing@synced": false,
    "engineering@synced": false,
    "sales@synced": false,
    "design@synced": false,
    "legal@synced": false,
    "product-management@synced": false,
    "cowork-plugin-management@synced": false,
    "ruby-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "shipkit": {
      "source": {
        "source": "git",
        "url": "git@github.com:AnjanJ/shipkit.git"
      }
    },
    "bodhikit": {
      "source": {
        "source": "git",
        "url": "git@github.com:AnjanJ/bodhikit.git"
      }
    }
  },
  "alwaysThinkingEnabled": false,
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "custom:dotfiles",
  "switchModelsOnFlag": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMemoryEnabled": false,
  "enableArtifact": false,
  "enableWorkflows": false,
  "syncClaudeAiSkills": false,
  "deniedMcpServers": [
    { "serverName": "computer-use" },
    { "serverName": "claude.ai Claude Docs" }
  ],
  "skillOverrides": {
    "claude-api": "user-invocable-only",
    "dataviz": "user-invocable-only",
    "artifact-capabilities": "user-invocable-only",
    "artifact-design": "user-invocable-only",
    "artifact-diagramming": "user-invocable-only",
    "schedule": "user-invocable-only",
    "run": "user-invocable-only",
    "loop": "user-invocable-only",
    "plugin-authoring": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "simplify": "user-invocable-only",
    "security-review": "user-invocable-only",
    "init": "user-invocable-only",
    "code-review": "user-invocable-only",
    "workflow-authoring": "user-invocable-only"
  }
}
