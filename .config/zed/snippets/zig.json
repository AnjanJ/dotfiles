      "}"
    ],
    "description": "Private function"
  },
  "Thread pool": {
    "prefix": "threadpool",
    "body": [
      "var pool: std.Thread.Pool = undefined;",
      "try pool.init(.{ .allocator = allocator });",
      "defer pool.deinit();",
      "${0}"
    ],
    "description": "Thread pool initialization"
  }
}
