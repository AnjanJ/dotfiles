    "description": "Debug print"
  },
  "log": {
    "prefix": "log",
    "body": "std.log.info(\"${1:}\\n\", .{${0}});",
    "description": "Standard log info"
  },
  "ArrayList": {
    "prefix": "arraylist",
    "body": [
      "var ${1:list} = std.ArrayList(${2:type}).init(allocator);",
      "defer ${1:list}.deinit();",
      "${0}"
    ],
    "description": "ArrayList with defer deinit"
  },
  "HashMap": {
    "prefix": "hashmap",
    "body": [
