    "description": "While loop"
  },
  "switch": {
    "prefix": "switch",
    "body": [
      "switch (${1:value}) {",
      "    ${2:pattern} => ${3:result},",
      "    else => ${0},",
      "}"
    ],
    "description": "Switch expression"
  },
  "if else": {
    "prefix": "ife",
    "body": [
      "if (${1:condition}) {",
      "    ${2}",
      "} else {",
      "    ${0}",
      "}"
    ],
    "description": "If-else block"
  },
  "optional unwrap": {
    "prefix": "orelse",
    "body": "const ${1:value} = ${2:optional} orelse ${0:return};",
