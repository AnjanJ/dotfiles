{
  "main": {
    "prefix": "main",
    "body": [
      "const std = @import(\"std\");",
      "",
      "pub fn main() !void {",
      "    ${0}",
      "}"
    ],
    "description": "Main function with std import"
  },
  "main with allocator": {
    "prefix": "maina",
    "body": [
      "const std = @import(\"std\");",
      "",
      "pub fn main() !void {",
      "    var gpa = std.heap.GeneralPurposeAllocator(.{}){};",
      "    defer _ = gpa.deinit();",
      "    const allocator = gpa.allocator();",
      "    _ = allocator;",
      "",
      "    ${0}",
      "}"
    ],
    "description": "Main function with GPA allocator"
  },
  "test block": {
    "prefix": "test",
    "body": [
      "test \"${1:description}\" {",
      "    ${0}",
      "}"
    ],
    "description": "Test block"
  },
  "test with allocator": {
    "prefix": "testa",
    "body": [
      "test \"${1:description}\" {",
      "    const allocator = std.testing.allocator;",
      "    _ = allocator;",
      "",
      "    ${0}",
      "}"
    ],
    "description": "Test block with testing allocator"
  },
  "struct": {
    "prefix": "struct",
    "body": [
      "const ${1:Name} = struct {",
      "    ${2:field}: ${3:type},",
      "",
      "    pub fn init(${4:args}) ${1:Name} {",
      "        return .{",
      "            .${2:field} = ${5:value},",
      "        };",
      "    }",
      "",
      "    ${0}",
      "};"
    ],
    "description": "Struct with init function"
  },
  "enum": {
    "prefix": "enum",
    "body": [
      "const ${1:Name} = enum {",
      "    ${2:variant},",
      "    ${0}",
      "};"
    ],
    "description": "Enum definition"
  },
  "error set": {
    "prefix": "errset",
    "body": [
      "const ${1:Name}Error = error{",
      "    ${2:ErrorVariant},",
      "    ${0}",
      "};"
    ],
    "description": "Error set definition"
  },
  "for loop": {
    "prefix": "for",
    "body": [
      "for (${1:items}) |${2:item}| {",
      "    ${0}",
      "}"
    ],
    "description": "For loop"
  },
  "for with index": {
    "prefix": "fori",
    "body": [
      "for (${1:items}, 0..) |${2:item}, ${3:i}| {",
