      "*.ru",
      "*.arb",
      "*.jbuilder",
      "*.thor",
      "Thorfile",
      "Fastfile",
      "Podfile",
      "Vagrantfile",
      "Brewfile"
    ],
    "Gemfile": [
      "Ruby"
    ],
    "Guardfile": [
      "Ruby"
    ],
    "Rakefile": [
      "Ruby"
    ],
    "*.rake": [
      "Ruby"
    ],
    "*.gemspec": [
      "Ruby"
    ],
    "*.ru": [
      "Ruby"
    ],
    "*.arb": [
      "Ruby"
    ],
    "*.jbuilder": [
      "Ruby"
    ],
    "*.thor": [
      "Ruby"
    ],
    "Thorfile": [
      "Ruby"
    ],
    "Fastfile": [
