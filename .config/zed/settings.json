{
  "session": {
    "trust_all_worktrees": true
  },
  "minimap": {
    "show": "never"
  },
  "current_line_highlight": "line",
  "max_tabs": 10,
  "colorize_brackets": true,
  "show_completions_on_input": true,
  "auto_indent_on_paste": false,
  "linked_edits": true,
  "use_on_type_format": false,
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "icon_theme": "Zed (Default)",
  "cli_default_open_behavior": "existing_window",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Aura Dark"
  },
  "ui_font_size": 16,
  "buffer_font_size": 18.0,
  "buffer_font_family": "Fira Code",
  "buffer_font_features": {
    "calt": true,
    "liga": true
  },
  "buffer_line_height": {
    "custom": 1.6
  },
  "tab_size": 2,
  "hard_tabs": false,
  "soft_wrap": "editor_width",
  "preferred_line_length": 100,
  "format_on_save": "on",
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,
  "show_whitespaces": "none",
  "show_wrap_guides": true,
  "relative_line_numbers": false,
  "cursor_blink": true,
  "lsp_highlight_debounce": 100,
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/node_modules",
    "**/.next",
    "**/_build",
    "**/deps",
    "**/.elixir_ls",
    "**/tmp",
    "**/dist",
    "**/build",
    "**/coverage",
    "**/.cache",
    "**/vendor/bundle",
    "**/public/packs",
    "**/public/assets"
  ],
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": false,
    "show_parameter_hints": false,
    "show_other_hints": true,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50
  },
  "git": {
    "inline_blame": {
      "show_commit_summary": true
    }
  },
  "terminal": {
    "font_size": 13,
    "font_family": "JetBrains Mono",
    "line_height": {
      "custom": 1.4
    },
    "shell": {
      "program": "zsh"
    },
    "env": {
      "Q_NEW_SESSION": "\"1\"",
      "EDITOR": "zed --wait"
    },
    "copy_on_select": true,
    "dock": "bottom",
    "default_width": 640,
    "default_height": 320,
    "detect_venv": {
      "on": {
        "directories": [
          ".env",
          "env",
          ".venv",
          "venv"
        ],
        "activate_script": "default"
      }
    }
  },
  "project_panel": {
    "button": true,
    "dock": "left",
    "git_status": true,
    "indent_size": 20,
    "file_icons": true,
    "folder_icons": true,
    "auto_reveal_entries": true,
    "auto_fold_dirs": false
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "features": {
    "edit_prediction_provider": "zed"
  },
  "language_models": {
    "ollama": {
      "api_url": "http://localhost:11434",
      "available_models": [
        {
          "name": "qwen2.5-coder:7b-base",
          "display_name": "Qwen2.5 Coder 7B (local, FIM)",
          "max_tokens": 32768
        },
        {
          "name": "qwen3-coder:30b",
          "display_name": "Qwen3 Coder 30B (local, agent)",
          "max_tokens": 131072,
          "supports_tools": true
        }
      ]
    }
  },
  "agent": {
    "tool_permissions": {
      "tools": {
        "write_file": {
          "default": "allow"
        },
        "terminal": {
          "default": "allow"
        }
      }
    },
    "play_sound_when_agent_done": true,
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "deepseek",
      "model": "deepseek-v4-pro"
    },
    "inline_assistant_model": {
      "provider": "ollama",
      "model": "qwen3-coder:30b"
    },
    "commit_message_model": {
      "provider": "ollama",
      "model": "qwen2.5-coder:7b-base"
    },
    "thread_summary_model": {
      "provider": "ollama",
      "model": "qwen2.5-coder:7b-base"
    },
    "enabled": true,
    "button": true,
    "dock": "right",
    "default_width": 640,
    "default_height": 320,
    "inline_alternatives": [
      {
        "provider": "ollama",
        "model": "qwen3-coder:30b"
      },
      {
        "provider": "ollama",
        "model": "qwen2.5-coder:7b-base"
      },
      {
        "provider": "zed.dev",
        "model": "claude-sonnet-4-6-latest"
      },
      {
        "provider": "zed.dev",
        "model": "claude-opus-4-5"
      }
    ]
  },
  "context_servers": {
    "rails-ai-context": {
      "source": "custom",
      "command": "npx",
      "args": [
        "-y",
        "@crisnahine/rails-ai-context"
      ]
    },
    "git": {
      "source": "custom",
      "command": "uvx",
      "args": [
        "mcp-server-git"
      ]
    },
    "sequential-thinking": {
      "source": "custom",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    }
  },
  "languages": {
    "Ruby": {
      "colorize_brackets": true,
      "show_completions_on_input": true,
      "auto_indent_on_paste": false,
      "linked_edits": true,
      "use_on_type_format": false,
      "show_whitespaces": "none",
