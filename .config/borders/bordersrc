#!/bin/bash

# JankyBorders Configuration
# Highlights the active window with a colored border
# Colors use ARGB format: 0xAARRGGBB

options=(
    style=round
    width=6.0
    hidpi=on
    active_color=0xffa277ff      # Light gray/white for active window
    inactive_color=0xff6d6d6d    # Dark gray for inactive windows
    background_color=0x3015141b  # Subtle background
)

borders "${options[@]}"
