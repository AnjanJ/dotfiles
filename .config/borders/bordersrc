#!/bin/bash

# JankyBorders Configuration
# Highlights the active window with a colored border
# Colors use ARGB format: 0xAARRGGBB

options=(
    style=round
    width=6.0
    hidpi=on
    active_color=0xff7aa2f7      # Light gray/white for active window
    inactive_color=0xff565f89    # Dark gray for inactive windows
    background_color=0x301a1b26  # Subtle background
)

borders "${options[@]}"
