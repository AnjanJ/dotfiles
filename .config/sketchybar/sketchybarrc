#!/bin/bash

# SketchyBar Configuration
# Minimal, beautiful menu bar with Aerospace integration

# Colours are rendered by `dotfiles theme` into colors.sh next to this
# file (gitignored); plugins source the same file. Fallbacks keep the bar
# readable on a fresh clone before the first theme apply.
[ -f "$HOME/.config/sketchybar/colors.sh" ] && . "$HOME/.config/sketchybar/colors.sh"
export BLACK="${BLACK:-0xff1a1b26}"
export WHITE="${WHITE:-0xffc0caf5}"
export BAR_COLOR="${BAR_COLOR:-$BLACK}"
export ITEM_BG_COLOR="${ITEM_BG_COLOR:-0xff24283b}"
export ACCENT_COLOR="${ACCENT_COLOR:-0xff7aa2f7}"

##### Bar Appearance #####
sketchybar --bar \
    height=32 \
    color="$BAR_COLOR" \
    border_width=0 \
    shadow=on \
    sticky=on \
    padding_left=10 \
    padding_right=10

##### Changing Defaults #####
sketchybar --default \
    icon.font="FiraCode Nerd Font:Bold:14.0" \
    icon.color="$WHITE" \
    icon.padding_left=4 \
    icon.padding_right=4 \
    label.font="FiraCode Nerd Font:Bold:13.0" \
    label.color="$WHITE" \
    label.padding_left=4 \
    label.padding_right=4 \
    background.padding_left=4 \
    background.padding_right=4

##### Adding Left Items #####

# Aerospace Workspaces
sketchybar --add event aerospace_workspace_change \
           --add item aerospace.workspaces left \
           --set aerospace.workspaces \
                 icon= \
                 script="$HOME/.config/sketchybar/plugins/aerospace.sh" \
                 label.padding_right=10 \
                 background.color="$ITEM_BG_COLOR" \
                 background.corner_radius=5 \
                 background.height=24 \
           --subscribe aerospace.workspaces aerospace_workspace_change

##### Adding Right Items #####

# Clock
sketchybar --add item clock right \
           --set clock \
                 update_freq=10 \
                 icon= \
                 script="$HOME/.config/sketchybar/plugins/clock.sh" \
                 background.color="$ITEM_BG_COLOR" \
                 background.corner_radius=5 \
                 background.height=24

# Memory pressure (+ swap once it appears). Placed left of the clock so the
# two system-load items sit together. update_freq is 15s: pressure moves on
# the scale of loading a model or starting a service, not second to second.
sketchybar --add item memory right \
           --set memory \
                 update_freq=15 \
                 icon=󰍛 \
                 script="$HOME/.config/sketchybar/plugins/memory.sh" \
                 background.color="$ITEM_BG_COLOR" \
                 background.corner_radius=5 \
                 background.height=24

# CPU
sketchybar --add item cpu right \
           --set cpu \
                 update_freq=5 \
                 icon= \
                 script="$HOME/.config/sketchybar/plugins/cpu.sh" \
                 background.color="$ITEM_BG_COLOR" \
                 background.corner_radius=5 \
                 background.height=24

# Battery
sketchybar --add item battery right \
           --set battery \
                 update_freq=120 \
                 icon= \
                 script="$HOME/.config/sketchybar/plugins/battery.sh" \
                 background.color="$ITEM_BG_COLOR" \
                 background.corner_radius=5 \
                 background.height=24

##### Finalizing Setup #####
sketchybar --update
