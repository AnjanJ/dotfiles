# ============================================
# GHOSTTY CONFIGURATION
# ============================================
# Author: AJ
# Description: Ghostty terminal configuration
#              Theme managed by `dotfiles theme`
# ============================================

# THEME_START
theme = tokyonight_night
# THEME_END

# Font configuration
font-family = "Fira Code"
font-size = 14

# Window settings
window-padding-x = 10
window-padding-y = 10

# Cursor
cursor-style = block
cursor-style-blink = true

# Shell integration (auto-detect shell type)
shell-integration = detect

# Mouse
mouse-hide-while-typing = true

# ============================================
# NOTES
# ============================================
# Theme is switched automatically by `dotfiles theme`
# The THEME_START/THEME_END markers control the theme line.
# For more themes, see: https://ghostty.org/docs/features/theme
# ============================================
