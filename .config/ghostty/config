# ============================================
# GHOSTTY CONFIGURATION
# ============================================
# Author: AJ
# Description: Ghostty terminal configuration
#              Theme managed by `dotfiles theme`
# ============================================

# THEME_START
theme = Aura
# THEME_END

# Font configuration
font-family = "Fira Code"
font-size = 14

# Window settings
window-padding-x = 10
window-padding-y = 10

# Cursor
cursor-style = block
cursor-style-blink = true

# Shell integration (auto-detect shell type)
shell-integration = detect

# Mouse
mouse-hide-while-typing = true

# ============================================
# NOTES
# ============================================
# Theme is switched automatically by `dotfiles theme`
# The THEME_START/THEME_END markers control the theme line.
# For more themes, see: https://ghostty.org/docs/features/theme
# ============================================

# ── Clipboard ──────────────────────────────────────────────
# cmd+c keeps Ghostty's default `copy_to_clipboard:mixed` binding. Worth
# knowing why cmd+c can look broken: that action only consumes the key
# WHEN THERE IS A SELECTION. With nothing selected it falls through to the
# shell as SIGINT, which is correct but reads as "cmd+c did nothing".
#
# So the fix is to make selections survive rather than to rebind the key.

# Selecting text copies it to the system clipboard immediately, so cmd+c
# becomes a fallback rather than the only route. The default copies to the
# selection clipboard only, which macOS apps do not read.
copy-on-select = clipboard

# Do not drop the selection when output arrives or you start typing. On a
# busy terminal the default clears it out from under you mid-drag.
selection-clear-on-typing = false

# Strip trailing whitespace when copying, so pasted commands do not carry
# stray spaces from the terminal's line padding.
clipboard-trim-trailing-spaces = true

# Programs in the terminal may write the clipboard without prompting; reads
# still ask. Paste protection stays on: it warns before pasting text that
# contains newlines, which is what stops a pasted blob executing itself.
clipboard-write = allow
clipboard-read = ask
clipboard-paste-protection = true

# Hold shift to select with the mouse even when a full-screen program
# (vim, tmux, htop) has grabbed mouse reporting. Without this, selection is
# impossible inside those programs.
mouse-shift-capture = true

# ── Appearance ─────────────────────────────────────────────
# Match WezTerm, which already runs blurred and slightly transparent.
background-opacity = 0.96
background-blur = 20

# Hide the title bar chrome. AeroSpace manages window position and the
# sketchybar shows workspace state, so the macOS titlebar is dead space.
macos-titlebar-style = hidden

# Dim the inactive pane so the focused one is obvious at a glance.
unfocused-split-opacity = 0.85

# ── Behaviour ──────────────────────────────────────────────
# A new window/tab starts in the same directory as the current one --
# `cd` is by far the most-run command here, so not re-navigating helps.
window-inherit-working-directory = true
window-inherit-font-size = true

# Do not prompt when closing a surface that has no running process.
confirm-close-surface = false

# Quick terminal: a drop-down scratch terminal over whatever is on screen,
# the closest Ghostty gets to Warp's always-there feel. Toggle with
# cmd+`. It is a separate surface from normal windows, so AeroSpace's
# tiling rules do not apply to it.
keybind = global:super+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.12

# ── Keybindings ────────────────────────────────────────────
# Splits, matching the vim-style motions used everywhere else here.
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+shift+h=goto_split:left
keybind = super+shift+j=goto_split:bottom
keybind = super+shift+k=goto_split:top
keybind = super+shift+l=goto_split:right

# Jump to the previous prompt instead of scrolling by eye -- this is the
# single most useful thing shell integration buys you.
keybind = super+up=jump_to_prompt:-1
keybind = super+down=jump_to_prompt:1

# Dump the whole scrollback into $EDITOR. The nearest thing to selecting a
# long output block, which is the Warp feature with no direct equivalent.
keybind = super+shift+e=write_scrollback_file:open
